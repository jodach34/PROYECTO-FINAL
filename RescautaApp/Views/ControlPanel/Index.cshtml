@{
    ViewData["Title"] = "Panel de Control - Rescauta";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 h-screen flex flex-col overflow-hidden">

    <!-- Barra de Navegación Superior -->
    <header class="bg-white border-b px-6 py-3 flex justify-between items-center shadow-sm z-10">
        <div class="flex items-center space-x-6">
            <div class="flex items-center space-x-2">
                <span class="bg-green-600 text-white p-1.5 rounded-lg font-bold text-sm">🥗 Rescauta</span>
                <span class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Logística Comunitaria</span>
            </div>
            <nav class="flex space-x-6 text-sm font-semibold">
                <a href="/Home/Index" class="text-gray-500 hover:text-gray-700">Mapa Interactivo</a>
                <a href="/ControlPanel/Index" class="text-green-700 border-b-2 border-green-600 pb-1">Panel de Control</a>
                <a href="/FoodBank/Index" class="text-gray-500 hover:text-gray-700">Banco de Alimentos</a>
            </nav>
        </div>

        <div class="flex items-center space-x-4">
            <div class="relative">
                <input type="text" placeholder="Buscar comedores, alertas..." class="bg-gray-100 text-sm rounded-full pl-9 pr-4 py-1.5 w-64 border focus:outline-none" />
                <span class="absolute left-3 top-2.5 text-gray-400 text-xs">🔍</span>
            </div>
            <div class="flex items-center space-x-2 border-l pl-4">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100" alt="Usuario" class="w-8 h-8 rounded-full object-cover">
                <div class="text-left">
                    <p class="text-xs font-bold text-gray-800">María Elena S.</p>
                    <p class="text-[10px] text-gray-500">Coordinadora SJM</p>
                </div>
            </div>
        </div>
    </header>

    <!-- Contenido del Panel de Control -->
    <div class="flex-1 overflow-y-auto p-8">
        <!-- Encabezado de la Sección -->
        <div class="mb-6 flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Panel de Inventario y Kardex</h1>
                <p class="text-xs text-gray-500 mt-0.5">Olla Común La Esperanza (ID: COM-042) • Actualizado hoy 08:30 AM</p>
            </div>
            <span class="bg-gray-200 text-gray-700 px-3 py-1.5 rounded-full text-xs font-semibold flex items-center space-x-1">
                <span>📡</span> <span>Sin conexión — modo offline</span>
            </span>
        </div>

        <!-- Tarjetas de Métricas -->
        <div class="grid grid-cols-3 gap-6 mb-8">
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-200">
                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Stock de Arroz</span>
                <div class="flex justify-between items-end mt-3">
                    <div>
                        <h3 class="text-3xl font-extrabold text-gray-800">12 kg</h3>
                        <p class="text-xs text-red-500 font-semibold mt-1">Crítico (Aprox. 2 días)</p>
                    </div>
                    <div class="w-12 h-12 rounded-full border-4 border-red-500 flex items-center justify-center text-[10px] font-bold text-red-600">
                        15%
                    </div>
                </div>
            </div>

            <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-200">
                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Días de Gas Restantes</span>
                <div class="mt-3">
                    <h3 class="text-3xl font-extrabold text-gray-800">4 días</h3>
                    <p class="text-xs text-yellow-600 font-medium mt-1">1 Balón de GLP de 10kg conectado</p>
                </div>
            </div>

            <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-200">
                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Nivel de Agua</span>
                <div class="mt-3">
                    <div class="flex justify-between">
                        <h3 class="text-3xl font-extrabold text-gray-800">450 Litros</h3>
                        <span class="text-xs font-bold text-green-600">45%</span>
                    </div>
                    <p class="text-xs text-gray-500 mt-1">Tanque de Reserva</p>
                    <div class="w-full bg-gray-200 h-1.5 rounded-full mt-2 overflow-hidden">
                        <div class="bg-green-600 h-full rounded-full" style="width: 45%"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla de Movimientos / Kardex -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6">
            <div class="flex justify-between items-center mb-4">
                <h3 class="font-bold text-gray-800 text-base">Registro de Movimientos (Kardex Reciente)</h3>
                <a href="#" class="text-green-700 text-xs font-bold hover:underline">Ver Historial Completo →</a>
            </div>

            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b text-[10px] text-gray-400 uppercase tracking-wider">
                        <th class="py-3">Fecha</th>
                        <th class="py-3">Insumo / Producto</th>
                        <th class="py-3">Tipo</th>
                        <th class="py-3">Cantidad</th>
                        <th class="py-3">Responsable</th>
                    </tr>
                </thead>
                <tbody class="text-xs divide-y">
                    <tr>
                        <td class="py-3.5 text-gray-600">Hoy, 07:15 AM</td>
                        <td class="py-3.5 font-bold text-gray-800">Arroz Extra Fino</td>
                        <td class="py-3.5"><span class="bg-red-100 text-red-700 px-2 py-1 rounded-md font-semibold text-[10px]">SALIDA (Consumo)</span></td>
                        <td class="py-3.5 font-bold text-red-600">- 4.5 kg</td>
                        <td class="py-3.5 text-gray-600">Juana Quispe (Cocina)</td>
                    </tr>
                    <tr>
                        <td class="py-3.5 text-gray-600">Ayer, 04:30 PM</td>
                        <td class="py-3.5 font-bold text-gray-800">Aceite Vegetal</td>
                        <td class="py-3.5"><span class="bg-green-100 text-green-700 px-2 py-1 rounded-md font-semibold text-[10px]">ENTRADA (Donación)</span></td>
                        <td class="py-3.5 font-bold text-green-600">+ 12 Litros</td>
                        <td class="py-3.5 text-gray-600">Donación Anónima</td>
                    </tr>
                    <tr>
                        <td class="py-3.5 text-gray-600">24 Ene, 11:00 AM</td>
                        <td class="py-3.5 font-bold text-gray-800">Balón de Gas GLP 10kg</td>
                        <td class="py-3.5"><span class="bg-red-100 text-red-700 px-2 py-1 rounded-md font-semibold text-[10px]">SALIDA (Consumo)</span></td>
                        <td class="py-3.5 font-bold text-red-600">- 1 unid.</td>
                        <td class="py-3.5 text-gray-600">Juana Quispe (Cocina)</td>
                    </tr>
                    <tr>
                        <td class="py-3.5 text-gray-600">23 Ene, 09:15 AM</td>
                        <td class="py-3.5 font-bold text-gray-800">Abastecimiento Agua Potable</td>
                        <td class="py-3.5"><span class="bg-green-100 text-green-700 px-2 py-1 rounded-md font-semibold text-[10px]">ENTRADA (Muni)</span></td>
                        <td class="py-3.5 font-bold text-green-600">+ 1000 Litros</td>
                        <td class="py-3.5 text-gray-600">Cisterna Distrital SJM</td>
                    </tr>
                </tbody>
            </table>

            <!-- Botones de Acción Inferiores -->
            <div class="flex justify-end gap-3 mt-6">
                <button class="bg-red-700 hover:bg-red-800 text-white px-4 py-2.5 rounded-xl text-xs font-bold transition shadow">
                    ⚠️ Reportar Faltante / Emergencia
                </button>
                <button class="bg-green-700 hover:bg-green-800 text-white px-4 py-2.5 rounded-xl text-xs font-bold transition shadow">
                    ➕ Registrar Consumo Diario
                </button>
            </div>
        </div>
    </div>

</body>
</html>