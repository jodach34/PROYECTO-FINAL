@model RescautaApp.Models.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Rescauta</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 flex items-center justify-center h-screen">
    <div class="bg-white p-8 rounded-xl shadow-lg w-96 border border-gray-200">
        <div class="flex items-center justify-center mb-4">
            <span class="bg-green-600 text-white p-2 rounded-lg font-bold text-lg">🥗 Rescauta</span>
        </div>
        <h2 class="text-xl font-bold text-center text-gray-800 mb-6">Logística Comunitaria</h2>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="All" class="text-red-500 text-xs mb-4 bg-red-50 p-2 rounded"></div>

            <div class="mb-4">
                <label class="block text-gray-700 text-sm font-bold mb-2">Nombre de Usuario:</label>
                <input asp-for="Usuario" class="shadow-sm appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-green-500" placeholder="Ej: María Elena S." />
            </div>

            <div class="mb-6">
                <label class="block text-gray-700 text-sm font-bold mb-2">Clave:</label>
                <input asp-for="Clave" type="password" class="shadow-sm appearance-none border rounded w-full py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:ring-2 focus:ring-green-500" placeholder="1234" />
            </div>

            <div class="flex items-center justify-between">
                <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded-lg focus:outline-none w-full transition duration-200 shadow">
                    Iniciar Sesión
                </button>
            </div>
        </form>
    </div>
</body>
</html>