@model AdminUsuariosViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Usuarios y permisos";
    ViewData["AppSection"] = "Administración";
    ViewData["AppTitle"] = "Usuarios y permisos";
    var roles = new[] { "Donante", "Operador", "Coordinador", "Administrador" };
}

<div class="rs-page-head">
    <div>
        <p class="rs-eyebrow">Administración</p>
        <h1 class="rs-page-title">Usuarios, solicitudes y asignaciones.</h1>
        <p class="rs-page-subtitle">Aprueba operadores, ajusta roles y define qué comedores puede atender cada cuenta.</p>
    </div>
    <form method="get" asp-controller="AdminUsuarios" asp-action="Index" class="flex flex-wrap gap-2">
        <input class="rs-input" name="busqueda" value="@Model.Busqueda" placeholder="Buscar por nombre o correo" />
        <button class="rs-btn rs-btn--secondary" type="submit">Buscar</button>
    </form>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Exito))
{
    <div class="rs-alert rs-alert--ok mb-4" role="status"><span>@Model.Exito</span></div>
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="rs-alert rs-alert--error mb-4" role="alert"><span>@Model.Error</span></div>
}

<section class="rs-panel mb-4">
    <div class="rs-panel__head">
        <div>
            <h2 class="rs-panel__title">Solicitudes de Operador</h2>
            <p class="mt-1 text-[0.7rem] text-[#5f6f66]">Asigna al menos un comedor antes de aprobar.</p>
        </div>
        <span class="rs-badge rs-badge--neutral">@Model.Solicitudes.Count pendientes</span>
    </div>
    <div class="rs-panel__body">
        @if (Model.Solicitudes.Count == 0)
        {
            <p class="text-[0.8rem] text-[#5f6f66]">No hay solicitudes pendientes.</p>
        }
        else
        {
            <div class="grid gap-3">
                @foreach (var solicitud in Model.Solicitudes)
                {
                    <article class="rounded-xl border border-[#dce7df] bg-[#fbfdfb] p-4">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div>
                                <p class="text-[0.85rem] font-extrabold">@solicitud.Nombre</p>
                                <p class="text-[0.72rem] text-[#5f6f66]">@solicitud.Correo · @solicitud.Organizacion</p>
                                @if (!string.IsNullOrWhiteSpace(solicitud.ComedorSolicitadoNombre))
                                {
                                    <p class="mt-1 text-[0.7rem] font-bold text-[#1b6b4a]">Comedor solicitado: @solicitud.ComedorSolicitadoNombre</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(solicitud.Mensaje))
                                {
                                    <p class="mt-1 text-[0.7rem] leading-5 text-[#5f6f66]">@solicitud.Mensaje</p>
                                }
                            </div>
                            <span class="text-[0.66rem] font-bold text-[#8b9a91]">@solicitud.FechaSolicitud.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        </div>

                        <div class="mt-3 grid gap-3 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)]">
                            <form method="post" asp-controller="AdminUsuarios" asp-action="Aprobar" class="flex flex-wrap items-end gap-2">
                                <input type="hidden" name="usuarioId" value="@solicitud.UsuarioId" />
                                <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                                <div class="min-w-[220px] flex-1">
                                    <label class="rs-label" for="aprobar-@solicitud.UsuarioId">Comedores asignados</label>
                                    <select class="rs-select" id="aprobar-@solicitud.UsuarioId" name="comedorIds" multiple size="3" required>
                                        @foreach (var comedor in Model.Comedores)
                                        {
                                            <option value="@comedor.Id" selected="@(comedor.Id == solicitud.ComedorSolicitadoId)">@comedor.Nombre</option>
                                        }
                                    </select>
                                </div>
                                <button class="rs-btn rs-btn--primary" type="submit">Aprobar</button>
                            </form>

                            <form method="post" asp-controller="AdminUsuarios" asp-action="Rechazar" class="flex flex-wrap items-end gap-2">
                                <input type="hidden" name="usuarioId" value="@solicitud.UsuarioId" />
                                <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                                <div class="min-w-[180px] flex-1">
                                    <label class="rs-label" for="rechazo-@solicitud.UsuarioId">Motivo del rechazo</label>
                                    <input class="rs-input" id="rechazo-@solicitud.UsuarioId" name="motivo" required placeholder="Explica el motivo" />
                                </div>
                                <button class="rs-btn rs-btn--secondary" type="submit">Rechazar</button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

<section class="rs-panel">
    <div class="rs-panel__head">
        <div>
            <h2 class="rs-panel__title">Cuentas registradas</h2>
            <p class="mt-1 text-[0.7rem] text-[#5f6f66]">Los cambios de rol y estado se aplican de inmediato.</p>
        </div>
        <span class="rs-badge rs-badge--neutral">@Model.Usuarios.Count cuentas</span>
    </div>
    <div class="rs-panel__body">
        @if (Model.Usuarios.Count == 0)
        {
            <p class="text-[0.8rem] text-[#5f6f66]">No hay cuentas que coincidan con la búsqueda.</p>
        }
        else
        {
            <div class="grid gap-3">
                @foreach (var usuario in Model.Usuarios)
                {
                    <article class="rounded-xl border border-[#dce7df] bg-white p-4">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div>
                                <div class="flex flex-wrap items-center gap-2">
                                    <p class="text-[0.85rem] font-extrabold">@usuario.Nombre</p>
                                    <span class="rs-badge rs-badge--neutral">@usuario.Rol</span>
                                    <span class="rs-badge @(usuario.Estado == "Activo" ? "rs-badge--ok" : "rs-badge--alerta")">@usuario.Estado</span>
                                </div>
                                <p class="mt-1 text-[0.72rem] text-[#5f6f66]">@usuario.Correo@(string.IsNullOrWhiteSpace(usuario.Organizacion) ? "" : $" · {usuario.Organizacion}")</p>
                                <p class="mt-1 text-[0.68rem] text-[#8b9a91]">
                                    Registro: @usuario.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy")
                                    @(usuario.UltimoAcceso is null ? "" : $" · Último acceso: {usuario.UltimoAcceso.Value.ToLocalTime():dd/MM/yyyy HH:mm}")
                                </p>
                                <p class="mt-1 text-[0.7rem] font-bold text-[#1b6b4a]">
                                    Comedores:
                                    @(usuario.Comedores.Count == 0 ? "sin asignación" : string.Join(", ", usuario.Comedores.Select(c => c.Nombre)))
                                </p>
                            </div>
                        </div>

                        <div class="mt-3 grid gap-3 xl:grid-cols-3">
                            <form method="post" asp-controller="AdminUsuarios" asp-action="CambiarRol" class="flex items-end gap-2">
                                <input type="hidden" name="usuarioId" value="@usuario.Id" />
                                <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                                <div class="flex-1">
                                    <label class="rs-label" for="rol-@usuario.Id">Rol</label>
                                    <select class="rs-select" id="rol-@usuario.Id" name="rol">
                                        @foreach (var rol in roles)
                                        {
                                            <option value="@rol" selected="@(rol == usuario.Rol)">@rol</option>
                                        }
                                    </select>
                                </div>
                                <button class="rs-btn rs-btn--secondary" type="submit">Cambiar</button>
                            </form>

                            <form method="post" asp-controller="AdminUsuarios" asp-action="CambiarEstado" class="flex items-end gap-2">
                                <input type="hidden" name="usuarioId" value="@usuario.Id" />
                                <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                                <input type="hidden" name="estado" value="@(usuario.Estado == "Activo" ? "Bloqueado" : "Activo")" />
                                <button class="rs-btn rs-btn--secondary" type="submit">
                                    @(usuario.Estado == "Activo" ? "Bloquear cuenta" : "Activar cuenta")
                                </button>
                            </form>

                            @if (usuario.Rol is "Operador" or "Coordinador")
                            {
                                <form method="post" asp-controller="AdminUsuarios" asp-action="AsignarComedores" class="flex items-end gap-2">
                                    <input type="hidden" name="usuarioId" value="@usuario.Id" />
                                    <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                                    <div class="flex-1">
                                        <label class="rs-label" for="comedores-@usuario.Id">Comedores asignados</label>
                                        <select class="rs-select" id="comedores-@usuario.Id" name="comedorIds" multiple size="3" required>
                                            @foreach (var comedor in Model.Comedores)
                                            {
                                                <option value="@comedor.Id" selected="@usuario.Comedores.Any(c => c.Id == comedor.Id)">@comedor.Nombre</option>
                                            }
                                        </select>
                                    </div>
                                    <button class="rs-btn rs-btn--primary" type="submit">Asignar</button>
                                </form>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
