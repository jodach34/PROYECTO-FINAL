@{
    ViewData["Title"] = "Mapa Interactivo";
    Layout = null;
}

@await Html.PartialAsync("_RescautaHead")

<body class="bg-canvas h-screen flex flex-col overflow-hidden text-ink antialiased">

    @await Html.PartialAsync("_RescautaNav", "mapa")

    <div class="flex-1 flex overflow-hidden">

        @* ================= SIDEBAR IZQUIERDO ================= *@
        <aside class="w-80 flex-none bg-white border-r border-gray-200 flex flex-col">
            <div class="px-5 pt-5 pb-4 border-b border-gray-100">
                <h1 class="text-base font-extrabold text-ink">Comedores Registrados</h1>
                <p class="text-[11px] text-muted mt-0.5">Zona de cobertura: Lima Metropolitana</p>

                <div class="relative mt-4">
                    <input type="text" placeholder="Filtrar por nombre..."
                           class="w-full bg-canvas text-xs pl-8 pr-3 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand/30" />
                    <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
                        </svg>
                    </span>
                </div>

                <div class="mt-3">
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">Estado de Abastecimiento</p>
                    <div class="flex flex-wrap gap-1.5">
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-ink text-white">Todos</span>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-ok/10 text-ok border border-ok/25">Abastecido</span>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-alerta/10 text-alerta border border-alerta/25">Alerta</span>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-critico/10 text-critico border border-critico/25">Emergencia</span>
                    </div>
                </div>

                <div class="mt-3">
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">Distrito / Zona</p>
                    <select class="w-full text-xs px-2.5 py-2 rounded-lg border border-gray-200 bg-canvas focus:outline-none focus:ring-2 focus:ring-brand/30">
                        <option>Todos los distritos</option>
                        <option>San Juan de Miraflores</option>
                        <option>Villa María del Triunfo</option>
                        <option>Lurigancho-Chosica</option>
                        <option>Villa El Salvador</option>
                    </select>
                </div>
            </div>

            <p class="px-5 py-2.5 text-[10px] font-bold text-muted uppercase tracking-widest bg-canvas border-b border-gray-100">
                Mostrando 5 comedores
            </p>

            <div class="flex-1 overflow-y-auto divide-y divide-gray-100">

                @* --- Card 1: SELECCIONADA --- *@
                <a href="#" class="block px-5 py-3.5 bg-brand-lt border-l-4 border-brand transition-colors">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0">
                            <p class="text-xs font-extrabold text-ink truncate">Olla Común La Esperanza</p>
                            <p class="text-[10px] text-muted mt-0.5">Sector 3, San Juan de Miraflores</p>
                        </div>
                        <span class="flex-none px-2 py-0.5 rounded bg-critico text-white text-[9px] font-extrabold uppercase tracking-wide">Emergencia</span>
                    </div>
                    <div class="flex items-center gap-3 mt-2.5 text-[10px] text-muted">
                        <span class="font-semibold text-ink">180 raciones/día</span>
                        <span class="w-px h-3 bg-gray-300"></span>
                        <span>Stock 15%</span>
                    </div>
                    <div class="w-full bg-gray-200 h-1 rounded-full mt-2 overflow-hidden">
                        <div class="bg-critico h-full rounded-full" style="width:15%"></div>
                    </div>
                </a>

                @* --- Card 2 --- *@
                <a href="#" class="block px-5 py-3.5 border-l-4 border-transparent hover:bg-canvas transition-colors">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0">
                            <p class="text-xs font-bold text-ink truncate">Comedor Santa Rosa</p>
                            <p class="text-[10px] text-muted mt-0.5">Villa María del Triunfo</p>
                        </div>
                        <span class="flex-none px-2 py-0.5 rounded bg-alerta/10 text-alerta text-[9px] font-extrabold uppercase tracking-wide">Alerta</span>
                    </div>
                    <div class="flex items-center gap-3 mt-2.5 text-[10px] text-muted">
                        <span class="font-semibold text-ink">150 raciones/día</span>
                        <span class="w-px h-3 bg-gray-300"></span>
                        <span>Stock 45%</span>
                    </div>
                    <div class="w-full bg-gray-200 h-1 rounded-full mt-2 overflow-hidden">
                        <div class="bg-alerta h-full rounded-full" style="width:45%"></div>
                    </div>
                </a>

                @* --- Card 3 --- *@
                <a href="#" class="block px-5 py-3.5 border-l-4 border-transparent hover:bg-canvas transition-colors">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0">
                            <p class="text-xs font-bold text-ink truncate">Comedor Las Palmeras</p>
                            <p class="text-[10px] text-muted mt-0.5">Lurigancho-Chosica</p>
                        </div>
                        <span class="flex-none px-2 py-0.5 rounded bg-ok/10 text-ok text-[9px] font-extrabold uppercase tracking-wide">Abastecido</span>
                    </div>
                    <div class="flex items-center gap-3 mt-2.5 text-[10px] text-muted">
                        <span class="font-semibold text-ink">220 raciones/día</span>
                        <span class="w-px h-3 bg-gray-300"></span>
                        <span>Stock 82%</span>
                    </div>
                    <div class="w-full bg-gray-200 h-1 rounded-full mt-2 overflow-hidden">
                        <div class="bg-ok h-full rounded-full" style="width:82%"></div>
                    </div>
                </a>

                @* --- Card 4 --- *@
                <a href="#" class="block px-5 py-3.5 border-l-4 border-transparent hover:bg-canvas transition-colors">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0">
                            <p class="text-xs font-bold text-ink truncate">Olla Común San Martín</p>
                            <p class="text-[10px] text-muted mt-0.5">Villa El Salvador</p>
                        </div>
                        <span class="flex-none px-2 py-0.5 rounded bg-alerta/10 text-alerta text-[9px] font-extrabold uppercase tracking-wide">Alerta</span>
                    </div>
                    <div class="flex items-center gap-3 mt-2.5 text-[10px] text-muted">
                        <span class="font-semibold text-ink">95 raciones/día</span>
                        <span class="w-px h-3 bg-gray-300"></span>
                        <span>Stock 38%</span>
                    </div>
                    <div class="w-full bg-gray-200 h-1 rounded-full mt-2 overflow-hidden">
                        <div class="bg-alerta h-full rounded-full" style="width:38%"></div>
                    </div>
                </a>

                @* --- Card 5 --- *@
                <a href="#" class="block px-5 py-3.5 border-l-4 border-transparent hover:bg-canvas transition-colors">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0">
                            <p class="text-xs font-bold text-ink truncate">Comedor Villa Unión</p>
                            <p class="text-[10px] text-muted mt-0.5">Pucusana, Lima</p>
                        </div>
                        <span class="flex-none px-2 py-0.5 rounded bg-ok/10 text-ok text-[9px] font-extrabold uppercase tracking-wide">Abastecido</span>
                    </div>
                    <div class="flex items-center gap-3 mt-2.5 text-[10px] text-muted">
                        <span class="font-semibold text-ink">130 raciones/día</span>
                        <span class="w-px h-3 bg-gray-300"></span>
                        <span>Stock 74%</span>
                    </div>
                    <div class="w-full bg-gray-200 h-1 rounded-full mt-2 overflow-hidden">
                        <div class="bg-ok h-full rounded-full" style="width:74%"></div>
                    </div>
                </a>

            </div>
        </aside>

        @* ================= AREA PRINCIPAL: MAPA ================= *@
        <section class="flex-1 relative overflow-hidden bg-[#E9EFEA]">

            @* --- Mapa SVG estatico (sin libreria de mapas) --- *@
            <svg class="absolute inset-0 w-full h-full" viewBox="0 0 1000 700" preserveAspectRatio="xMidYMid slice" aria-label="Mapa de comedores">
                <defs>
                    <g id="calles">
                        <path d="M-20 150 H1020" />
                        <path d="M-20 300 H1020" />
                        <path d="M-20 450 H1020" />
                        <path d="M-20 600 H1020" />
                        <path d="M150 -20 V720" />
                        <path d="M400 -20 V720" />
                        <path d="M650 -20 V720" />
                        <path d="M880 -20 V720" />
                        <path d="M-20 690 L1020 40" />
                    </g>
                </defs>

                <rect width="1000" height="700" fill="#E9EFEA" />

                @* Rio *@
                <path d="M790,-30 C730,140 860,250 780,390 C720,500 800,600 760,730"
                      stroke="#CFE0EA" stroke-width="52" fill="none" stroke-linecap="round" />

                @* Areas verdes *@
                <rect x="30" y="480" width="150" height="130" rx="14" fill="#D6E5D1" />
                <rect x="430" y="60"  width="180" height="90"  rx="14" fill="#D6E5D1" />
                <circle cx="935" cy="560" r="70" fill="#D6E5D1" />

                @* Manzanas *@
                <g fill="#F2F5F2">
                    <rect x="30"  y="180" width="100" height="95"  rx="6" />
                    <rect x="180" y="180" width="90"  height="95"  rx="6" />
                    <rect x="300" y="180" width="75"  height="95"  rx="6" />
                    <rect x="180" y="330" width="90"  height="95"  rx="6" />
                    <rect x="300" y="330" width="75"  height="95"  rx="6" />
                    <rect x="430" y="180" width="195" height="95"  rx="6" />
                    <rect x="680" y="180" width="160" height="95"  rx="6" />
                    <rect x="430" y="480" width="195" height="95"  rx="6" />
                    <rect x="680" y="480" width="80"  height="95"  rx="6" />
                    <rect x="680" y="330" width="160" height="95"  rx="6" />
                </g>

                @* Calles: casing + calzada *@
                <use href="#calles" stroke="#D7DFD8" stroke-width="15" fill="none" stroke-linecap="round" />
                <use href="#calles" stroke="#FFFFFF" stroke-width="9"  fill="none" stroke-linecap="round" />

                @* Etiquetas de distrito *@
                <g font-family="system-ui, sans-serif" font-size="13" font-weight="700" fill="#9AA79B" letter-spacing="1.5">
                    <text x="60"  y="555">PARQUE EL BOSQUE</text>
                    <text x="455" y="110">P. VILLA UNIÓN</text>
                    <text x="700" y="350">ZONA SUR</text>
                </g>
                <g font-family="system-ui, sans-serif" font-size="12" font-weight="600" fill="#B6C0B7">
                    <text x="330" y="290">Av. Los heroism</text>
                    <text x="470" y="600">Calle Las Begonias</text>
                </g>
            </svg>

            @* --- Marcadores --- *@
            @{
                // Datos ficticios de los pines: posicion en % sobre el contenedor
                var pines = new[] {
                    new { Left = 30, Top = 41, Color = "critico", Selected = true,  Nombre = "Olla Común La Esperanza" },
                    new { Left = 49, Top = 62, Color = "alerta",  Selected = false, Nombre = "Comedor Santa Rosa" },
                    new { Left = 63, Top = 32, Color = "ok",      Selected = false, Nombre = "Comedor Las Palmeras" },
                    new { Left = 22, Top = 76, Color = "alerta",  Selected = false, Nombre = "Olla Común San Martín" },
                    new { Left = 57, Top = 80, Color = "ok",      Selected = false, Nombre = "Comedor Villa Unión" }
                };
            }

            @foreach (var pin in pines)
            {
                <div class="absolute z-10 -translate-x-1/2 -translate-y-full"
                     style="left:@pin.Left%; top:@pin.Top%;"
                     title="@pin.Nombre">
                    <div class="relative flex flex-col items-center">
                        @if (pin.Selected)
                        {
                            <span class="absolute -inset-2 rounded-full bg-critico/20 animate-ping"></span>
                        }
                        <div class="relative w-9 h-9 rounded-full border-[3px] border-white shadow-lg flex items-center justify-center text-white bg-@pin.Color @(pin.Selected ? "scale-110" : "")">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" /><path d="M7 2v20" />
                                <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3zm0 0v7" />
                            </svg>
                        </div>
                        <div class="w-3 h-3 rotate-45 bg-@pin.Color border-r-2 border-b-2 border-white -mt-1.5"></div>
                        @if (pin.Selected)
                        {
                            <span class="mt-1.5 bg-ink text-white text-[9px] font-extrabold uppercase tracking-wide px-2 py-0.5 rounded whitespace-nowrap shadow">La Esperanza</span>
                        }
                    </div>
                </div>
            }

            @* --- Controles de zoom (decorativos) --- *@
            <div class="absolute top-4 right-4 z-10 flex flex-col rounded-lg shadow-card border border-gray-200 overflow-hidden">
                <button class="w-8 h-8 bg-white hover:bg-canvas text-lg leading-none text-muted">+</button>
                <div class="h-px bg-gray-200"></div>
                <button class="w-8 h-8 bg-white hover:bg-canvas text-lg leading-none text-muted">&minus;</button>
            </div>

            @* --- Leyenda --- *@
            <div class="absolute bottom-4 right-4 z-10 bg-white/95 backdrop-blur rounded-xl shadow-card border border-gray-200 px-3.5 py-3">
                <p class="text-[10px] font-extrabold text-muted uppercase tracking-widest mb-2">Leyenda</p>
                <div class="space-y-1.5">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-critico"></span>
                        <span class="text-[11px] font-semibold text-ink">Emergencia</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-alerta"></span>
                        <span class="text-[11px] font-semibold text-ink">Alerta</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-ok"></span>
                        <span class="text-[11px] font-semibold text-ink">Abastecido</span>
                    </div>
                </div>
            </div>

            @* --- Ficha flotante del comedor seleccionado --- *@
            <div class="absolute left-5 bottom-5 z-20 w-[370px] bg-white rounded-2xl shadow-[0_8px_32px_rgba(31,41,55,.14)] border border-gray-200 overflow-hidden">
                <div class="h-1.5 bg-critico"></div>
                <div class="p-5">
                    <span class="inline-block px-2.5 py-1 rounded-md bg-critico text-white text-[10px] font-extrabold uppercase tracking-widest">
                        Emergencia
                    </span>
                    <h2 class="text-lg font-extrabold text-ink mt-2.5">Olla Común La Esperanza</h2>
                    <p class="text-[11px] text-muted mt-1">Asoc. De Vivienda La Esperanza, Sector 3, SJM</p>

                    <div class="grid grid-cols-2 gap-3 mt-4">
                        <div class="bg-canvas rounded-lg p-2.5">
                            <p class="text-[9px] font-bold text-gray-400 uppercase tracking-wider">Raciones Diarias</p>
                            <p class="text-xs font-extrabold text-ink mt-0.5">180 raciones</p>
                        </div>
                        <div class="bg-canvas rounded-lg p-2.5">
                            <p class="text-[9px] font-bold text-gray-400 uppercase tracking-wider">Contacto Directo</p>
                            <p class="text-xs font-extrabold text-ink mt-0.5">+51 984 732 104</p>
                        </div>
                    </div>

                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mt-5 mb-2.5">Inventario Crítico</p>
                    <div class="space-y-3">
                        <div>
                            <div class="flex justify-between text-[11px] mb-1">
                                <span class="font-semibold text-ink">Viveres Secos</span>
                                <span class="font-extrabold text-critico">15%</span>
                            </div>
                            <div class="w-full bg-gray-200 h-1.5 rounded-full overflow-hidden">
                                <div class="bg-critico h-full rounded-full" style="width:15%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-[11px] mb-1">
                                <span class="font-semibold text-ink">Agua Potable</span>
                                <span class="font-extrabold text-alerta">45%</span>
                            </div>
                            <div class="w-full bg-gray-200 h-1.5 rounded-full overflow-hidden">
                                <div class="bg-alerta h-full rounded-full" style="width:45%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-[11px] mb-1">
                                <span class="font-semibold text-ink">Gas Licuado</span>
                                <span class="font-extrabold text-ok">60%</span>
                            </div>
                            <div class="w-full bg-gray-200 h-1.5 rounded-full overflow-hidden">
                                <div class="bg-ok h-full rounded-full" style="width:60%"></div>
                            </div>
                        </div>
                    </div>

                    <button class="w-full mt-5 bg-brand hover:bg-brand-dk text-white py-3 rounded-xl text-xs font-extrabold tracking-wide transition-colors shadow-sm">
                        Planificar Ruta de Entrega
                    </button>
                </div>
            </div>

        </section>
    </div>

</body>
</html>
