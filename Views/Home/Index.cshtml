@model MapaViewModel
@{
    ViewData["Title"] = "Mapa Interactivo";
    Layout = null;

    // Los distritos salen de la base, no de un catalogo escrito a mano: si manana se
    // registra un comedor en un distrito nuevo, el filtro lo muestra sin tocar la vista.
    var distritos = Model.Comedores
        .Select(c => c.Distrito)
        .Where(d => !string.IsNullOrWhiteSpace(d))
        .Distinct()
        .OrderBy(d => d)
        .ToList();

    // El primer comedor de la lista es el mas urgente: la API ya los ordena por estado.
    var destacado = Model.Comedores.FirstOrDefault();
}

@await Html.PartialAsync("_RescautaHead")

<body class="bg-canvas h-screen flex flex-col overflow-hidden text-ink antialiased">

    @await Html.PartialAsync("_RescautaNav", "mapa")

    <div class="flex-1 flex overflow-hidden">

        @* ================= SIDEBAR IZQUIERDO ================= *@
        <aside class="w-80 flex-none bg-white border-r border-gray-200 flex flex-col">
            <div class="px-5 pt-5 pb-4 border-b border-gray-100">
                <h1 class="text-base font-extrabold text-ink">Comedores Registrados</h1>
                <p class="text-[11px] text-muted mt-0.5">Zona de cobertura: Lima Metropolitana</p>

                @if (Model.Error is not null)
                {
                    @* Sin API no hay mapa, pero la pantalla tiene que decir por que en vez de
                       salir vacia: un 500 en blanco hace pensar que no hay comedores. *@
                    <div class="mt-3 px-3 py-2.5 rounded-lg bg-critico/10 border border-critico/25 text-[11px] text-critico font-semibold" role="alert">
                        @Model.Error
                    </div>
                }

                <div class="relative mt-4">
                    <input type="text" placeholder="Filtrar por nombre..."
                           class="w-full bg-canvas text-xs pl-8 pr-3 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand/30" />
                    <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
                        </svg>
                    </span>
                </div>

                <div class="mt-3">
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">Estado de Abastecimiento</p>
                    <div class="flex flex-wrap gap-1.5">
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-ink text-white">Todos</span>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-ok/10 text-ok border border-ok/25">Abastecido</span>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-alerta/10 text-alerta border border-alerta/25">Alerta</span>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-critico/10 text-critico border border-critico/25">Emergencia</span>
                    </div>
                </div>

                <div class="mt-3">
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">Distrito / Zona</p>
                    <select class="w-full text-xs px-2.5 py-2 rounded-lg border border-gray-200 bg-canvas focus:outline-none focus:ring-2 focus:ring-brand/30">
                        <option>Todos los distritos</option>
                        @foreach (var distrito in distritos)
                        {
                            <option>@distrito</option>
                        }
                    </select>
                </div>
            </div>

            <p class="px-5 py-2.5 text-[10px] font-bold text-muted uppercase tracking-widest bg-canvas border-b border-gray-100">
                Mostrando @Model.Comedores.Count @(Model.Comedores.Count == 1 ? "comedor" : "comedores")
            </p>

            <div class="flex-1 overflow-y-auto divide-y divide-gray-100">

                @foreach (var comedor in Model.Comedores)
                {
                    var ancho = Math.Clamp((double)comedor.PorcentajeAbastecimiento, 0d, 100d);
                    var color = Presentacion.ColorEstado(comedor.Estado);
                    var esDestacado = destacado is not null && comedor.Id == destacado.Id;

                    @* El enlace va al Panel con el id del comedor: el mapa y el panel son la
                       misma red vista de dos formas, y el pin tiene que llevar a su ficha. *@
                    <a href="@Url.Action("Index", "ControlPanel", new { comedorId = comedor.Id })"
                       class="block px-5 py-3.5 border-l-4 transition-colors @(esDestacado ? "bg-brand-lt border-brand" : "border-transparent hover:bg-canvas")">
                        <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0">
                                <p class="text-xs truncate @(esDestacado ? "font-extrabold" : "font-bold") text-ink">@comedor.Nombre</p>
                                <p class="text-[10px] text-muted mt-0.5">@comedor.Distrito</p>
                            </div>
                            <span class="flex-none px-2 py-0.5 rounded text-[9px] font-extrabold uppercase tracking-wide @(comedor.Estado == "Emergencia" ? "bg-critico text-white" : Presentacion.ClaseEstado(comedor.Estado))">@comedor.Estado</span>
                        </div>
                        <div class="flex items-center gap-3 mt-2.5 text-[10px] text-muted">
                            <span class="font-semibold text-ink">@comedor.RacionesDiarias raciones/día</span>
                            <span class="w-px h-3 bg-gray-300"></span>
                            <span>Stock @comedor.PorcentajeAbastecimiento.ToString("0.#")%</span>
                        </div>
                        <div class="w-full bg-gray-200 h-1 rounded-full mt-2 overflow-hidden">
                            <div class="h-full rounded-full bg-@color" style="width:@ancho.ToString("0.##")%"></div>
                        </div>
                    </a>
                }

                @if (Model.Comedores.Count == 0)
                {
                    <p class="px-5 py-8 text-center text-xs text-muted">
                        No hay comedores registrados.
                    </p>
                }

            </div>
        </aside>

        @* ================= AREA PRINCIPAL: MAPA ================= *@
        <section class="flex-1 relative overflow-hidden bg-[#E9EFEA]">

            @* --- Mapa SVG estatico (sin libreria de mapas) --- *@
            <svg class="absolute inset-0 w-full h-full" viewBox="0 0 1000 700" preserveAspectRatio="xMidYMid slice" aria-label="Mapa de comedores">
                <defs>
                    <g id="calles">
                        <path d="M-20 150 H1020" />
                        <path d="M-20 300 H1020" />
                        <path d="M-20 450 H1020" />
                        <path d="M-20 600 H1020" />
                        <path d="M150 -20 V720" />
                        <path d="M400 -20 V720" />
                        <path d="M650 -20 V720" />
                        <path d="M880 -20 V720" />
                        <path d="M-20 690 L1020 40" />
                    </g>
                </defs>

                <rect width="1000" height="700" fill="#E9EFEA" />

                @* Rio *@
                <path d="M790,-30 C730,140 860,250 780,390 C720,500 800,600 760,730"
                      stroke="#CFE0EA" stroke-width="52" fill="none" stroke-linecap="round" />

                @* Areas verdes *@
                <rect x="30" y="480" width="150" height="130" rx="14" fill="#D6E5D1" />
                <rect x="430" y="60"  width="180" height="90"  rx="14" fill="#D6E5D1" />
                <circle cx="935" cy="560" r="70" fill="#D6E5D1" />

                @* Manzanas *@
                <g fill="#F2F5F2">
                    <rect x="30"  y="180" width="100" height="95"  rx="6" />
                    <rect x="180" y="180" width="90"  height="95"  rx="6" />
                    <rect x="300" y="180" width="75"  height="95"  rx="6" />
                    <rect x="180" y="330" width="90"  height="95"  rx="6" />
                    <rect x="300" y="330" width="75"  height="95"  rx="6" />
                    <rect x="430" y="180" width="195" height="95"  rx="6" />
                    <rect x="680" y="180" width="160" height="95"  rx="6" />
                    <rect x="430" y="480" width="195" height="95"  rx="6" />
                    <rect x="680" y="480" width="80"  height="95"  rx="6" />
                    <rect x="680" y="330" width="160" height="95"  rx="6" />
                </g>

                @* Calles: casing + calzada *@
                <use href="#calles" stroke="#D7DFD8" stroke-width="15" fill="none" stroke-linecap="round" />
                <use href="#calles" stroke="#FFFFFF" stroke-width="9"  fill="none" stroke-linecap="round" />

                @* Etiquetas de distrito *@
                <g font-family="system-ui, sans-serif" font-size="13" font-weight="700" fill="#9AA79B" letter-spacing="1.5">
                    <text x="60"  y="555">PARQUE EL BOSQUE</text>
                    <text x="455" y="110">P. VILLA UNIÓN</text>
                    <text x="700" y="350">ZONA SUR</text>
                </g>
                <g font-family="system-ui, sans-serif" font-size="12" font-weight="600" fill="#B6C0B7">
                    <text x="330" y="290">Av. Los heroism</text>
                    <text x="470" y="600">Calle Las Begonias</text>
                </g>
            </svg>

            @* --- Marcadores --- *@
            @* La posicion del pin NO esta en la vista: viene de MapaX y MapaY, que el
               dominio guarda en el comedor. Asi el pin sigue en su sitio aunque se mueva
               el mapa de fondo, y registrar un comedor nuevo no obliga a editar el Razor. *@
            @foreach (var comedor in Model.Comedores)
            {
                var color = Presentacion.ColorEstado(comedor.Estado);
                var esDestacado = destacado is not null && comedor.Id == destacado.Id;

                <a href="@Url.Action("Index", "ControlPanel", new { comedorId = comedor.Id })"
                   class="absolute z-10 -translate-x-1/2 -translate-y-full"
                   style="left:@comedor.MapaX.ToString("0.##")%; top:@comedor.MapaY.ToString("0.##")%;"
                   title="@comedor.Nombre (@comedor.PorcentajeAbastecimiento.ToString("0.#")%)">
                    <div class="relative flex flex-col items-center">
                        @if (esDestacado)
                        {
                            <span class="absolute -inset-2 rounded-full bg-@color/20 animate-ping"></span>
                        }
                        <div class="relative w-9 h-9 rounded-full border-[3px] border-white shadow-lg flex items-center justify-center text-white bg-@color @(esDestacado ? "scale-110" : "")">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" /><path d="M7 2v20" />
                                <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3zm0 0v7" />
                            </svg>
                        </div>
                        <div class="w-3 h-3 rotate-45 bg-@color border-r-2 border-b-2 border-white -mt-1.5"></div>
                        @if (esDestacado)
                        {
                            <span class="mt-1.5 bg-ink text-white text-[9px] font-extrabold uppercase tracking-wide px-2 py-0.5 rounded whitespace-nowrap shadow">@comedor.Nombre</span>
                        }
                    </div>
                </a>
            }

            @* --- Controles de zoom (decorativos) --- *@
            <div class="absolute top-4 right-4 z-10 flex flex-col rounded-lg shadow-card border border-gray-200 overflow-hidden">
                <button class="w-8 h-8 bg-white hover:bg-canvas text-lg leading-none text-muted">+</button>
                <div class="h-px bg-gray-200"></div>
                <button class="w-8 h-8 bg-white hover:bg-canvas text-lg leading-none text-muted">&minus;</button>
            </div>

            @* --- Leyenda --- *@
            <div class="absolute bottom-4 right-4 z-10 bg-white/95 backdrop-blur rounded-xl shadow-card border border-gray-200 px-3.5 py-3">
                <p class="text-[10px] font-extrabold text-muted uppercase tracking-widest mb-2">Leyenda</p>
                <div class="space-y-1.5">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-critico"></span>
                        <span class="text-[11px] font-semibold text-ink">Emergencia</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-alerta"></span>
                        <span class="text-[11px] font-semibold text-ink">Alerta</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-ok"></span>
                        <span class="text-[11px] font-semibold text-ink">Abastecido</span>
                    </div>
                </div>
            </div>

            @* --- Ficha flotante del comedor mas urgente --- *@
            @* Solo se pinta si hay comedores. Con la API caida la seccion desaparece en vez
               de mostrar datos viejos, que es peor que no mostrar nada. *@
            @if (destacado is not null)
            {
                var colorFicha = Presentacion.ColorEstado(destacado.Estado);

                <div class="absolute left-5 bottom-5 z-20 w-[370px] bg-white rounded-2xl shadow-[0_8px_32px_rgba(31,41,55,.14)] border border-gray-200 overflow-hidden">
                    <div class="h-1.5 bg-@colorFicha"></div>
                    <div class="p-5">
                        <span class="inline-block px-2.5 py-1 rounded-md bg-@colorFicha text-white text-[10px] font-extrabold uppercase tracking-widest">
                            @destacado.Estado
                        </span>
                        <h2 class="text-lg font-extrabold text-ink mt-2.5">@destacado.Nombre</h2>
                        <p class="text-[11px] text-muted mt-1">@destacado.Distrito</p>
                        <div class="grid grid-cols-2 gap-3 mt-4">
                            <div class="bg-canvas rounded-lg p-2.5">
                                <p class="text-[9px] font-bold text-gray-400 uppercase tracking-wider">Raciones Diarias</p>
                                <p class="text-xs font-extrabold text-ink mt-0.5">@destacado.RacionesDiarias raciones</p>
                            </div>
                            <div class="bg-canvas rounded-lg p-2.5">
                                <p class="text-[9px] font-bold text-gray-400 uppercase tracking-wider">Insumos</p>
                                <p class="text-xs font-extrabold text-ink mt-0.5">@destacado.TotalInsumos registrados</p>
                            </div>
                        </div>
                        <a href="@Url.Action("Index", "ControlPanel", new { comedorId = destacado.Id })"
                           class="block w-full mt-5 bg-brand hover:bg-brand-dk text-white py-3 rounded-xl text-xs font-extrabold tracking-wide transition-colors shadow-sm text-center">
                            Ver detalle y kardex
                        </a>
                    </div>
                </div>
            }

        </section>
    </div>

</body>
</html>