@model MapaViewModel
@{
    Layout = "_PublicLayout";
    var destacados = Model.Comedores
        .OrderBy(c => c.Estado switch { "Emergencia" => 0, "Alerta" => 1, "Abastecido" => 2, _ => 3 })
        .Take(3)
        .ToList();
    var hayDatos = Model.Comedores.Count > 0;
}
@section Head {
    <style>
        .rs-home-hero .rs-hero__photo { inset: 0 0 2.1rem 1.6rem; }
        @@media (min-width: 1024px) {
            .rs-home-hero .rs-hero__photo { inset: 0 0 2.4rem 2.1rem; }
        }
    </style>
}

<section class="rs-hero rs-home-hero">
    <div class="rs-container">
        <div class="rs-hero__grid">
            <div>
                <p class="rs-eyebrow">Red de comedores comunitarios</p>
                <h1 class="rs-hero__title">
                    Comida que <em>vuelve a servir</em>, personas que vuelven a creer.
                </h1>
                <p class="rs-hero__lead">
                    Rescauta conecta alimentos disponibles con comedores que cocinan para su comunidad. Menos desperdicio, más platos servidos y una red que responde a tiempo.
                </p>
                <div class="rs-hero__actions">
                    <a class="rs-btn rs-btn--primary" asp-controller="Comedores" asp-action="Index">
                        Explorar comedores
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M5 12h14" />
                            <path d="m12 5 7 7-7 7" />
                        </svg>
                    </a>
                    <a class="rs-btn rs-btn--secondary" asp-controller="Home" asp-action="Donaciones">
                        Quiero donar
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 21s-7-4.35-7-10a4 4 0 0 1 7-2.65A4 4 0 0 1 19 11c0 5.65-7 10-7 10Z" />
                        </svg>
                    </a>
                </div>
                <div class="rs-hero__trust">
                    <span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m5 12 4 4L19 6" />
                        </svg>
                        Trazabilidad por donación
                    </span>
                    <span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="8" />
                            <path d="M12 8v4l3 2" />
                        </svg>
                        Información actualizada
                    </span>
                </div>
            </div>

            <div class="rs-hero__media">
                <div class="rs-hero__photo">
                    <img src="~/img/hero-voluntarios.jpg" alt="Voluntarios preparando y organizando alimentos en un comedor comunitario" />
                </div>
                <div class="rs-hero__floating rs-hero__floating--top">
                    <small>Red activa</small>
                    <strong>@(hayDatos ? Model.Comedores.Count.ToString("N0") : "—") comedores</strong>
                    <div class="rs-hero__mini-row">
                        <span>@(hayDatos ? Model.TotalRaciones.ToString("N0") : "—") raciones/día</span>
                        <span class="rs-badge rs-badge--brand">En red</span>
                    </div>
                </div>
                <div class="rs-hero__floating rs-hero__floating--bottom">
                    <div class="flex items-center justify-between gap-3">
                        <div>
                            <small>Comedores en riesgo</small>
                            <strong>@(hayDatos ? Model.EnRiesgo.ToString("N0") : "—")</strong>
                        </div>
                        <div class="rs-hero__avatar-stack" aria-hidden="true">
                            <span>CO</span>
                            <span>MU</span>
                            <span>+</span>
                        </div>
                    </div>
                    <div class="rs-hero__mini-row">
                        <span>Alerta o emergencia</span>
                        <a class="rs-link-arrow text-[0.68rem]" asp-controller="Comedores" asp-action="Index">Ver red</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="rs-section rs-section--tight">
    <div class="rs-container">
        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="rs-alert rs-alert--warn mb-5" role="status">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 shrink-0">
                    <path d="M12 9v4" />
                    <path d="M12 17h.01" />
                    <path d="M10.3 4.7 2.9 18a1.7 1.7 0 0 0 1.5 2.5h15.2a1.7 1.7 0 0 0 1.5-2.5L13.7 4.7a1.9 1.9 0 0 0-3.4 0Z" />
                </svg>
                <span><strong>No pudimos actualizar la red.</strong> @Model.Error Los indicadores se muestran sin datos en lugar de inventar cifras.</span>
            </div>
        }

        <div class="rs-impact" data-reveal>
            <div class="rs-metric">
                <p class="rs-metric__label">Comedores registrados</p>
                <p class="rs-metric__value">@(hayDatos ? Model.Comedores.Count.ToString("N0") : "—")</p>
                <p class="rs-metric__note">Organizaciones que forman parte de la red.</p>
            </div>
            <div class="rs-metric">
                <p class="rs-metric__label">Raciones diarias</p>
                <p class="rs-metric__value">@(hayDatos ? Model.TotalRaciones.ToString("N0") : "—")</p>
                <p class="rs-metric__note">Capacidad declarada por los comedores.</p>
            </div>
            <div class="rs-metric">
                <p class="rs-metric__label">Abastecimiento promedio</p>
                <p class="rs-metric__value">@(hayDatos ? $"{Model.PromedioAbastecimiento:0.#}%" : "—")</p>
                <p class="rs-metric__note">Promedio del inventario disponible.</p>
            </div>
            <div class="rs-metric rs-metric--accent">
                <p class="rs-metric__label">Requieren atención</p>
                <p class="rs-metric__value">@(hayDatos ? Model.EnRiesgo.ToString("N0") : "—")</p>
                <p class="rs-metric__note">Comedores en alerta o emergencia.</p>
            </div>
        </div>
    </div>
</section>

<section class="rs-section">
    <div class="rs-container grid items-center gap-10 lg:grid-cols-[0.92fr_1.08fr] lg:gap-16">
        <div class="rs-photo-frame aspect-[4/3] lg:aspect-[5/4]" data-reveal>
            <img class="rs-photo" src="~/img/comedor-comunitario.jpg" alt="Comedor comunitario sirviendo alimentos a personas de la comunidad" loading="lazy" />
            <div class="rs-photo-frame__caption">
                <p>La comida es un punto de encuentro.</p>
                <p>Y también una forma de cuidar a quienes tenemos cerca.</p>
            </div>
        </div>
        <div data-reveal>
            <p class="rs-eyebrow">El problema que nos mueve</p>
            <h2 class="rs-title">El alimento no falta. Lo que falta es conectarlo mejor.</h2>
            <p class="rs-lead">
                Cada día se pierden alimentos en un extremo de la ciudad mientras un comedor en el otro no sabe si podrá completar el menú. Rescauta hace visible esa brecha y la convierte en una oportunidad de acción.
            </p>
            <div class="mt-8 grid gap-3 sm:grid-cols-2">
                <div class="rs-feature">
                    <span class="rs-icon-box" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 19V5" />
                            <path d="M4 19h16" />
                            <path d="m7 14 4-4 3 2 5-6" />
                        </svg>
                    </span>
                    <h3>Menos desperdicio</h3>
                    <p>Identificar excedentes y necesidades para que cada alimento encuentre un destino útil.</p>
                </div>
                <div class="rs-feature">
                    <span class="rs-icon-box" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 20h18" />
                            <path d="M5 20V9l7-5 7 5v11" />
                            <path d="M9 20v-6h6v6" />
                        </svg>
                    </span>
                    <h3>Comedores visibles</h3>
                    <p>Un directorio claro para conocer qué hacen, dónde están y qué necesitan con urgencia.</p>
                </div>
            </div>
            <a class="rs-link-arrow mt-7" asp-controller="Home" asp-action="Nosotros">
                Conoce nuestro propósito
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                </svg>
            </a>
        </div>
    </div>
</section>

<section class="rs-section rs-section--cream">
    <div class="rs-container">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <p class="rs-eyebrow">Mapa de la red</p>
                <h2 class="rs-title rs-title--sm">Así se ve la solidaridad, zona por zona.</h2>
                <p class="rs-lead">Consulta el estado de abastecimiento de cada comedor y encuentra dónde hace más falta tu apoyo.</p>
            </div>
            <a class="rs-btn rs-btn--secondary shrink-0" asp-controller="Comedores" asp-action="Index">
                Abrir directorio
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                </svg>
            </a>
        </div>

        <div class="mt-8 grid gap-5 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,0.65fr)]">
            <div data-reveal>
                @await Html.PartialAsync("_MapaComedores", Model)
            </div>

            <aside class="rs-card p-5" data-reveal>
                <div class="flex items-center justify-between gap-3">
                    <div>
                        <p class="text-[0.62rem] font-black uppercase tracking-[0.14em] text-[#5f6f66]">Atención prioritaria</p>
                        <h3 class="mt-1 font-display text-lg font-extrabold tracking-[-0.03em]">Comedores que necesitan apoyo</h3>
                    </div>
                    <span class="rs-badge rs-badge--alerta">Ahora</span>
                </div>

                <div class="mt-5 space-y-3">
                    @if (destacados.Count == 0)
                    {
                        <p class="text-sm leading-6 text-[#5f6f66]">No hay comedores para mostrar en este momento.</p>
                    }
                    else
                    {
                        @foreach (var comedor in destacados)
                        {
                            <a class="block rounded-xl border border-[#dce7df] p-3.5 transition hover:border-[#27865d] hover:bg-[#f2f8f4]" asp-controller="Comedores" asp-action="Detalle" asp-route-id="@comedor.Id">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="min-w-0">
                                        <p class="truncate text-[0.8rem] font-extrabold text-[#13251c]">@comedor.Nombre</p>
                                        <p class="mt-0.5 text-[0.68rem] font-semibold text-[#5f6f66]">@comedor.Distrito · @comedor.RacionesDiarias raciones/día</p>
                                    </div>
                                    <span class="@Presentacion.ClaseEstado(comedor.Estado)">@Presentacion.EtiquetaEstado(comedor.Estado)</span>
                                </div>
                                <div class="mt-3 flex items-center gap-2">
                                    <div class="rs-progress">
                                        <span class="@Presentacion.ClaseBarra(comedor.Estado)" style="width:@Math.Clamp(comedor.PorcentajeAbastecimiento, 0m, 100m)%"></span>
                                    </div>
                                    <span class="text-[0.65rem] font-black text-[#5f6f66]">@comedor.PorcentajeAbastecimiento.ToString("0.#")%</span>
                                </div>
                            </a>
                        }
                    }
                </div>

                <a class="rs-link-arrow mt-5" asp-controller="Comedores" asp-action="Index">
                    Ver todos los comedores
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14" />
                        <path d="m12 5 7 7-7 7" />
                    </svg>
                </a>
            </aside>
        </div>
    </div>
</section>

<section class="rs-section">
    <div class="rs-container">
        <div class="max-w-2xl">
            <p class="rs-eyebrow">Tres formas de sumarte</p>
            <h2 class="rs-title rs-title--sm">La red funciona cuando cada parte encuentra su lugar.</h2>
        </div>

        <div class="mt-8 grid gap-4 md:grid-cols-3">
            <article class="rs-feature" data-reveal>
                <span class="rs-icon-box" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 20h18" />
                        <path d="M5 20V9l7-5 7 5v11" />
                        <path d="M9 20v-6h6v6" />
                    </svg>
                </span>
                <h3>Para comedores</h3>
                <p>Visibiliza tu labor, mantén tu inventario al día y recibe apoyo de una red que entiende tu trabajo.</p>
                <a class="rs-link-arrow mt-4" asp-controller="Cuenta" asp-action="Registro">Registrar un comedor</a>
            </article>
            <article class="rs-feature" data-reveal>
                <span class="rs-icon-box" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 21s-7-4.35-7-10a4 4 0 0 1 7-2.65A4 4 0 0 1 19 11c0 5.65-7 10-7 10Z" />
                    </svg>
                </span>
                <h3>Para donantes</h3>
                <p>Dona alimentos o recursos a una necesidad concreta y sigue el recorrido de tu aporte hasta el comedor.</p>
                <a class="rs-link-arrow mt-4" asp-controller="Home" asp-action="Donaciones">Ver formas de donar</a>
            </article>
            <article class="rs-feature" data-reveal>
                <span class="rs-icon-box" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="8" r="3.2" />
                        <path d="M3.5 20c.8-3 2.6-4.4 5.5-4.4s4.7 1.4 5.5 4.4" />
                        <path d="M16 5.5a3 3 0 0 1 0 5.8" />
                        <path d="M17.5 15.6c2 .5 3.2 1.9 3.8 4.4" />
                    </svg>
                </span>
                <h3>Para voluntarios</h3>
                <p>Súmate a jornadas de cocina, clasificación o entrega y conoce de cerca el impacto de tu tiempo.</p>
                <a class="rs-link-arrow mt-4" asp-controller="Home" asp-action="Contacto">Quiero ser voluntario</a>
            </article>
        </div>
    </div>
</section>

<section class="rs-section rs-section--ink">
    <div class="rs-container">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
            <div>
                <p class="rs-eyebrow rs-eyebrow--light">Cómo funciona</p>
                <h2 class="rs-title text-white">De la necesidad a la entrega, sin vueltas.</h2>
                <p class="rs-lead">Un flujo simple para que la ayuda llegue rápido y cada donación pueda seguirse con claridad.</p>
                <a class="rs-btn rs-btn--light mt-7" asp-controller="Home" asp-action="ComoFunciona">
                    Conocer el proceso
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14" />
                        <path d="m12 5 7 7-7 7" />
                    </svg>
                </a>
            </div>
            <div class="grid gap-3">
                <div class="rounded-2xl border border-white/10 bg-white/[0.055] p-4">
                    <div class="flex gap-3">
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#c9e79d] font-display text-xs font-extrabold text-[#0b2a1d]">01</span>
                        <div>
                            <h3 class="text-sm font-extrabold text-white">El comedor actualiza su inventario</h3>
                            <p class="mt-1 text-xs leading-6 text-white/55">Lo que hay y lo que hace falta queda visible para toda la red.</p>
                        </div>
                    </div>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/[0.055] p-4">
                    <div class="flex gap-3">
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/10 font-display text-xs font-extrabold text-white">02</span>
                        <div>
                            <h3 class="text-sm font-extrabold text-white">Un donante elige cómo ayudar</h3>
                            <p class="mt-1 text-xs leading-6 text-white/55">Puede aportar un insumo específico con una cantidad concreta.</p>
                        </div>
                    </div>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/[0.055] p-4">
                    <div class="flex gap-3">
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/10 font-display text-xs font-extrabold text-white">03</span>
                        <div>
                            <h3 class="text-sm font-extrabold text-white">La entrega se vuelve trazable</h3>
                            <p class="mt-1 text-xs leading-6 text-white/55">Cada donación recibe un código para consultar su estado y su destino.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="rs-section">
    <div class="rs-container">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <p class="rs-eyebrow">Cerca de ti</p>
                <h2 class="rs-title rs-title--sm">Comedores que ya están haciendo la diferencia.</h2>
            </div>
            <a class="rs-link-arrow" asp-controller="Comedores" asp-action="Index">
                Ver directorio completo
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                </svg>
            </a>
        </div>

        <div class="mt-7 grid gap-4 md:grid-cols-3">
            @if (destacados.Count == 0)
            {
                <div class="rs-empty md:col-span-3">
                    <span class="rs-empty__icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 12h16" />
                            <path d="M5 12a7 7 0 0 0 14 0" />
                            <path d="M9 16h6" />
                        </svg>
                    </span>
                    <h3>Aún no hay comedores disponibles</h3>
                    <p>El directorio se llenará cuando la API esté disponible y existan organizaciones registradas.</p>
                </div>
            }
            else
            {
                @foreach (var comedor in destacados)
                {
                    <article class="rs-card rs-card--hover rs-comedor-card" data-reveal>
                        <div class="rs-comedor-card__top">
                            <div>
                                <h3 class="rs-comedor-card__title">@comedor.Nombre</h3>
                                <p class="rs-comedor-card__meta">@comedor.Distrito</p>
                            </div>
                            <span class="@Presentacion.ClaseEstado(comedor.Estado)">@Presentacion.EtiquetaEstado(comedor.Estado)</span>
                        </div>
                        <div class="rs-comedor-card__stats">
                            <span>@comedor.RacionesDiarias raciones/día</span>
                            <span>@comedor.TotalInsumos insumos</span>
                        </div>
                        <div class="mt-auto">
                            <div class="mb-1.5 flex items-center justify-between text-[0.65rem] font-bold text-[#5f6f66]">
                                <span>Abastecimiento</span>
                                <span>@comedor.PorcentajeAbastecimiento.ToString("0.#")%</span>
                            </div>
                            <div class="rs-progress">
                                <span class="@Presentacion.ClaseBarra(comedor.Estado)" style="width:@Math.Clamp(comedor.PorcentajeAbastecimiento, 0m, 100m)%"></span>
                            </div>
                        </div>
                        <div class="rs-comedor-card__footer">
                            <span class="text-[0.66rem] font-semibold text-[#5f6f66]">Parte de la red Rescauta</span>
                            <a class="rs-link-arrow" asp-controller="Comedores" asp-action="Detalle" asp-route-id="@comedor.Id">
                                Ver ficha
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M5 12h14" />
                                    <path d="m12 5 7 7-7 7" />
                                </svg>
                            </a>
                        </div>
                    </article>
                }
            }
        </div>
    </div>
</section>

<section class="rs-section--tight pb-16">
    <div class="rs-container">
        <div class="relative overflow-hidden rounded-[28px] bg-[#145039] px-6 py-10 text-white sm:px-10 lg:flex lg:items-center lg:justify-between lg:gap-10 lg:py-12">
            <div class="pointer-events-none absolute -right-16 -top-20 h-64 w-64 rounded-full border border-white/10"></div>
            <div class="pointer-events-none absolute -bottom-24 right-24 h-48 w-48 rounded-full bg-[#c9e79d]/10 blur-2xl"></div>
            <div class="relative max-w-2xl">
                <p class="text-[0.66rem] font-black uppercase tracking-[0.17em] text-[#c9e79d]">Tu aporte encuentra destino</p>
                <h2 class="mt-2 font-display text-2xl font-extrabold tracking-[-0.04em] sm:text-3xl">Hay un plato que puede servirse gracias a ti.</h2>
                <p class="mt-2 text-sm leading-7 text-white/65">Dona un insumo concreto o súmate como voluntario. La red está lista para recibirte.</p>
            </div>
            <div class="relative mt-6 flex flex-wrap gap-2 lg:mt-0 lg:shrink-0">
                <a class="rs-btn rs-btn--light" asp-controller="Home" asp-action="Donaciones">Quiero donar</a>
                <a class="rs-btn rs-btn--primary" asp-controller="Comedores" asp-action="Index">Explorar comedores</a>
            </div>
        </div>
    </div>
</section>
