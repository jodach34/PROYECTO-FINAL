@{
    ViewData["Title"] = "Panel de Control";
    Layout = null;
}

@await Html.PartialAsync("_RescautaHead")

<body class="bg-canvas h-screen flex flex-col overflow-hidden text-ink antialiased">

    @await Html.PartialAsync("_RescautaNav", "panel")

    <div class="flex-1 overflow-y-auto p-8">

        @* ================= ENCABEZADO ================= *@
        <div class="mb-6 flex items-start justify-between gap-4">
            <div>
                <h1 class="text-2xl font-extrabold text-ink">Panel de Inventario y Kardex</h1>
                <p class="text-xs text-muted mt-1">Olla Común La Esperanza (ID: COM-042) • Actualizado hoy 08:30 AM</p>
            </div>
            <span class="flex-none bg-gray-200 text-muted px-3 py-1.5 rounded-full text-xs font-bold flex items-center gap-1.5">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 2l20 20M8.5 16.5a5 5 0 0 1 7 0M5 13a10 10 0 0 1 4-2.7M2 9a15 15 0 0 1 5.2-3.3M1 5a20 20 0 0 1 6-3.6" />
                    <path d="M20.5 16.5a5 5 0 0 0-4-2.4" /><path d="M22 13a10 10 0 0 0-3-2" />
                </svg>
                Sin conexión — modo offline
            </span>
        </div>

        @* ================= TARJETAS DE METRICAS ================= *@
        <div class="grid grid-cols-3 gap-6 mb-8">

            @* 1. Stock de Arroz *@
            <div class="bg-white p-5 rounded-2xl shadow-card border border-gray-200">
                <span class="text-[10px] font-extrabold text-gray-400 uppercase tracking-widest">Stock de Arroz</span>
                <div class="flex items-end justify-between mt-3">
                    <div>
                        <h3 class="text-3xl font-extrabold text-ink">12 kg</h3>
                        <p class="text-xs text-critico font-bold mt-1">Crítico (Aprox. 2 días)</p>
                    </div>
                    <div class="w-14 h-14 rounded-full border-[5px] border-critico/20 border-t-critico flex items-center justify-center text-[10px] font-extrabold text-critico">
                        15%
                    </div>
                </div>
            </div>

            @* 2. Dias de Gas *@
            <div class="bg-white p-5 rounded-2xl shadow-card border border-gray-200">
                <span class="text-[10px] font-extrabold text-gray-400 uppercase tracking-widest">Días de Gas Restantes</span>
                <div class="flex items-end justify-between mt-3">
                    <div>
                        <h3 class="text-3xl font-extrabold text-ink">4 días</h3>
                        <p class="text-xs text-alerta font-bold mt-1">1 Balón de GLP de 10kg conectado</p>
                    </div>
                    <span class="w-11 h-11 rounded-xl bg-alerta/10 text-alerta flex items-center justify-center flex-none">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M10.3 21.5 2 13.2a1 1 0 0 1 0-1.4l8.3-8.3a1 1 0 0 1 1.4 0l8.3 8.3a1 1 0 0 1 0 1.4z" />
                            <path d="M7.5 10.5 12 15M15 6.5l-3.5 3.5" />
                        </svg>
                    </span>
                </div>
            </div>

            @* 3. Nivel de Agua *@
            <div class="bg-white p-5 rounded-2xl shadow-card border border-gray-200">
                <span class="text-[10px] font-extrabold text-gray-400 uppercase tracking-widest">Nivel de Agua</span>
                <div class="mt-3">
                    <div class="flex items-end justify-between">
                        <h3 class="text-3xl font-extrabold text-ink">450 Litros</h3>
                        <span class="text-xs font-extrabold text-ok pb-1">45%</span>
                    </div>
                    <p class="text-xs text-muted mt-1">Tanque de Reserva</p>
                    <div class="w-full bg-gray-200 h-1.5 rounded-full mt-2.5 overflow-hidden">
                        <div class="bg-ok h-full rounded-full" style="width:45%"></div>
                    </div>
                </div>
            </div>
        </div>

        @* ================= TABLA KARDEX ================= *@
        <div class="bg-white rounded-2xl shadow-card border border-gray-200 p-6">
            <div class="flex items-center justify-between mb-5">
                <h2 class="font-extrabold text-ink text-base">Registro de Movimientos (Kardex Reciente)</h2>
                <a href="#" class="text-brand text-xs font-extrabold hover:underline">Ver Historial Completo →</a>
            </div>

            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-gray-200 text-[10px] text-gray-400 uppercase tracking-widest">
                        <th class="py-3 font-bold">Fecha</th>
                        <th class="py-3 font-bold">Insumo / Producto</th>
                        <th class="py-3 font-bold">Tipo</th>
                        <th class="py-3 font-bold">Cantidad</th>
                        <th class="py-3 font-bold">Responsable</th>
                    </tr>
                </thead>
                <tbody class="text-xs divide-y divide-gray-100">

                    <tr>
                        <td class="py-3.5 text-muted">Hoy, 07:15 AM</td>
                        <td class="py-3.5 font-bold text-ink">Arroz Extra Fino</td>
                        <td class="py-3.5"><span class="bg-critico/10 text-critico px-2 py-1 rounded-md font-extrabold text-[10px]">SALIDA (Consumo)</span></td>
                        <td class="py-3.5 font-extrabold text-critico">- 4.5 kg</td>
                        <td class="py-3.5 text-muted">Juana Quispe (Cocina)</td>
                    </tr>

                    <tr>
                        <td class="py-3.5 text-muted">Ayer, 04:30 PM</td>
                        <td class="py-3.5 font-bold text-ink">Aceite Vegetal</td>
                        <td class="py-3.5"><span class="bg-ok/10 text-ok px-2 py-1 rounded-md font-extrabold text-[10px]">ENTRADA (Donación)</span></td>
                        <td class="py-3.5 font-extrabold text-ok">+ 12 Litros</td>
                        <td class="py-3.5 text-muted">Donación Anónima</td>
                    </tr>

                    <tr>
                        <td class="py-3.5 text-muted">24 Ene, 11:00 AM</td>
                        <td class="py-3.5 font-bold text-ink">Balón de Gas GLP 10kg</td>
                        <td class="py-3.5"><span class="bg-critico/10 text-critico px-2 py-1 rounded-md font-extrabold text-[10px]">SALIDA (Consumo)</span></td>
                        <td class="py-3.5 font-extrabold text-critico">- 1 unid.</td>
                        <td class="py-3.5 text-muted">Juana Quispe (Cocina)</td>
                    </tr>

                    <tr>
                        <td class="py-3.5 text-muted">23 Ene, 09:15 AM</td>
                        <td class="py-3.5 font-bold text-ink">Abastecimiento Agua Potable</td>
                        <td class="py-3.5"><span class="bg-ok/10 text-ok px-2 py-1 rounded-md font-extrabold text-[10px]">ENTRADA (Muni)</span></td>
                        <td class="py-3.5 font-extrabold text-ok">+ 1000 Litros</td>
                        <td class="py-3.5 text-muted">Cisterna Distrital SJM</td>
                    </tr>

                    <tr>
                        <td class="py-3.5 text-muted">22 Ene, 05:40 PM</td>
                        <td class="py-3.5 font-bold text-ink">Lentejas Partida</td>
                        <td class="py-3.5"><span class="bg-ok/10 text-ok px-2 py-1 rounded-md font-extrabold text-[10px]">ENTRADA (Donación)</span></td>
                        <td class="py-3.5 font-extrabold text-ok">+ 25 kg</td>
                        <td class="py-3.5 text-muted">Dona. Teresa Vargas (Migrante)</td>
                    </tr>

                </tbody>
            </table>

            <div class="flex justify-end gap-3 mt-6 pt-6 border-t border-gray-100">
                <button class="bg-critico hover:opacity-90 text-white px-4 py-2.5 rounded-xl text-xs font-extrabold transition shadow-sm">
                    Reportar Faltante / Emergencia
                </button>
                <button class="bg-brand hover:bg-brand-dk text-white px-4 py-2.5 rounded-xl text-xs font-extrabold transition-colors shadow-sm">
                    Registrar Consumo Diario
                </button>
            </div>
        </div>

    </div>

</body>
</html>
