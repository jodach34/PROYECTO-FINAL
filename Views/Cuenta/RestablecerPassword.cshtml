@model RestablecerPasswordViewModel
@{
    Layout = "_AuthLayout";
}
<div class="rs-auth__card">
    <div class="flex items-start justify-between gap-4">
        <div>
            <p class="rs-eyebrow">Seguridad</p>
            <h1 class="mt-3 font-display text-2xl font-extrabold tracking-[-0.045em]">Nueva contraseña</h1>
            <p class="mt-2 text-[0.8rem] leading-6 text-[#5f6f66]">Elige una contraseña que no uses en otros servicios.</p>
        </div>
        <span class="rs-badge rs-badge--brand">Recuperación</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="rs-alert rs-alert--error mt-5" role="alert">
            <span>@Model.Error</span>
        </div>
    }

    @if (string.IsNullOrWhiteSpace(Model.Token))
    {
        <p class="mt-5 text-[0.8rem] leading-6 text-[#5f6f66]">
            El enlace no contiene un token válido.
            <a class="font-extrabold text-[#1b6b4a] hover:underline" asp-controller="Cuenta" asp-action="RecuperarPassword">Solicita uno nuevo</a>.
        </p>
    }
    else
    {
        <form class="mt-6 grid gap-4" method="post" asp-controller="Cuenta" asp-action="RestablecerPassword">
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="ModelOnly" class="rs-alert rs-alert--error" role="alert"></div>
            <div>
                <label class="rs-label" for="Password">Contraseña nueva *</label>
                <input class="rs-input" id="Password" asp-for="Password" type="password" autocomplete="new-password" required />
                <span class="rs-help text-[#b42318]" asp-validation-for="Password"></span>
            </div>
            <div>
                <label class="rs-label" for="PasswordConfirmar">Repetir contraseña *</label>
                <input class="rs-input" id="PasswordConfirmar" asp-for="PasswordConfirmar" type="password" autocomplete="new-password" required />
                <span class="rs-help text-[#b42318]" asp-validation-for="PasswordConfirmar"></span>
            </div>
            <button class="rs-btn rs-btn--primary rs-btn--block" type="submit">Guardar contraseña</button>
        </form>
    }

    <p class="mt-5 text-center text-[0.78rem] text-[#5f6f66]">
        <a class="font-extrabold text-[#1b6b4a] hover:underline" asp-controller="Cuenta" asp-action="Login">Volver a iniciar sesión</a>
    </p>
</div>
