@model RecuperarPasswordViewModel
@{
    Layout = "_AuthLayout";
}
<div class="rs-auth__card">
    <div class="flex items-start justify-between gap-4">
        <div>
            <p class="rs-eyebrow">Acceso</p>
            <h1 class="mt-3 font-display text-2xl font-extrabold tracking-[-0.045em]">Recupera tu acceso</h1>
            <p class="mt-2 text-[0.8rem] leading-6 text-[#5f6f66]">Indica el correo asociado a tu cuenta y te enviaremos las instrucciones.</p>
        </div>
        <span class="rs-badge rs-badge--brand">Seguridad</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
    {
        <div class="rs-alert rs-alert--ok mt-5" role="status">
            <span>@Model.Mensaje</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.EnlaceDesarrollo))
        {
            <div class="rs-alert rs-alert--info mt-3" role="status">
                <span>
                    Enlace de desarrollo:
                    <a class="font-extrabold underline underline-offset-2" href="@Model.EnlaceDesarrollo">restablecer contraseña</a>
                </span>
            </div>
        }
    }

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="rs-alert rs-alert--error mt-5" role="alert">
            <span>@Model.Error</span>
        </div>
    }

    <form class="mt-6 grid gap-4" method="post" asp-controller="Cuenta" asp-action="RecuperarPassword">
        <div asp-validation-summary="ModelOnly" class="rs-alert rs-alert--error" role="alert"></div>
        <div>
            <label class="rs-label" for="Correo">Correo electrónico</label>
            <input class="rs-input" id="Correo" asp-for="Correo" type="email" autocomplete="email" placeholder="nombre@correo.com" required />
            <span class="rs-help text-[#b42318]" asp-validation-for="Correo"></span>
        </div>
        <button class="rs-btn rs-btn--primary rs-btn--block" type="submit">Solicitar instrucciones</button>
    </form>

    <p class="mt-5 text-center text-[0.78rem] text-[#5f6f66]">
        <a class="font-extrabold text-[#1b6b4a] hover:underline" asp-controller="Cuenta" asp-action="Login">Volver a iniciar sesión</a>
    </p>
</div>
