@model ComedorDetalleViewModel
@{
    Layout = "_PublicLayout";
    var comedor = Model.Comedor;
}
<section class="border-b border-[#dce7df] bg-[#fbfdf9]">
    <div class="rs-container py-8 sm:py-10">
        <nav class="flex items-center gap-2 text-[0.7rem] font-bold text-[#5f6f66]" aria-label="Migas de pan">
            <a class="transition hover:text-[#1b6b4a]" asp-controller="Home" asp-action="Index">Inicio</a>
            <span aria-hidden="true">/</span>
            <a class="transition hover:text-[#1b6b4a]" asp-controller="Comedores" asp-action="Index">Comedores</a>
            <span aria-hidden="true">/</span>
            <span class="truncate text-[#13251c]">@(comedor?.Nombre ?? "Ficha")</span>
        </nav>

        @if (comedor is null)
        {
            <div class="rs-empty mt-7">
                <span class="rs-empty__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="7" />
                        <path d="m20 20-3.5-3.5" />
                    </svg>
                </span>
                <h1 class="text-lg font-extrabold">No pudimos abrir esta ficha</h1>
                <p>@(Model.Error ?? "El comedor solicitado no existe o no está disponible en este momento.")</p>
                <a class="rs-btn rs-btn--primary mt-5" asp-controller="Comedores" asp-action="Index">Volver al directorio</a>
            </div>
        }
        else
        {
            <div class="mt-6 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
                <div class="max-w-3xl">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="@Presentacion.ClaseEstado(comedor.Estado)">@Presentacion.EtiquetaEstado(comedor.Estado)</span>
                        <span class="rs-badge rs-badge--neutral">@comedor.Distrito</span>
                    </div>
                    <h1 class="rs-title mt-4">@comedor.Nombre</h1>
                    <p class="rs-lead">@comedor.Direccion</p>
                    <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-[0.76rem] font-semibold text-[#5f6f66]">
                        <span class="inline-flex items-center gap-1.5">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="9" cy="8" r="3" />
                                <path d="M3.5 20c.8-3 2.6-4.4 5.5-4.4s4.7 1.4 5.5 4.4" />
                                <path d="M16 5.5a3 3 0 0 1 0 5.8" />
                            </svg>
                            @comedor.RacionesDiarias raciones diarias
                        </span>
                        <span class="inline-flex items-center gap-1.5">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 7h18" />
                                <path d="M6 7v13h12V7" />
                                <path d="M9 7V4h6v3" />
                            </svg>
                            @comedor.Inventario.Count insumos registrados
                        </span>
                        @if (!string.IsNullOrWhiteSpace(comedor.ContactoTelefono))
                        {
                            <span class="inline-flex items-center gap-1.5">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.4 2.1L8.1 10a16 16 0 0 0 5.9 5.9l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z" />
                                </svg>
                                @comedor.ContactoTelefono
                            </span>
                        }
                    </div>
                </div>

                <div class="flex flex-wrap gap-2">
                    <a class="rs-btn rs-btn--secondary" asp-controller="Comedores" asp-action="Index">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m15 18-6-6 6-6" />
                        </svg>
                        Directorio
                    </a>
                    <a class="rs-btn rs-btn--primary" asp-controller="Home" asp-action="Donaciones">Apoyar este comedor</a>
                </div>
            </div>
        }
    </div>
</section>

@if (comedor is not null)
{
    <section class="rs-section--tight">
        <div class="rs-container grid gap-5 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,0.65fr)]">
            <div class="rs-panel">
                <div class="rs-panel__head">
                    <div>
                        <h2 class="rs-panel__title">Inventario actual</h2>
                        <p class="mt-1 text-[0.7rem] text-[#5f6f66]">Stock disponible por insumo y cobertura estimada.</p>
                    </div>
                    <span class="rs-badge rs-badge--brand">@comedor.Inventario.Count insumos</span>
                </div>
                <div class="rs-panel__body">
                    @if (comedor.Inventario.Count == 0)
                    {
                        <div class="rs-empty">
                            <span class="rs-empty__icon" aria-hidden="true">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 7h18" />
                                    <path d="M6 7v13h12V7" />
                                    <path d="M9 7V4h6v3" />
                                </svg>
                            </span>
                            <h3>Sin inventario publicado</h3>
                            <p>Este comedor todavía no registró insumos en la plataforma.</p>
                        </div>
                    }
                    else
                    {
                        <div class="grid gap-3 sm:grid-cols-2">
                            @foreach (var insumo in comedor.Inventario)
                            {
                                var porcentaje = Math.Clamp(insumo.Porcentaje ?? 0m, 0m, 100m);
                                var color = porcentaje >= 60m ? "ok" : porcentaje >= 30m ? "alerta" : "critico";
                                <article class="rounded-xl border border-[#dce7df] bg-[#fbfdfb] p-3.5">
                                    <div class="flex items-start justify-between gap-3">
                                        <div class="min-w-0">
                                            <h3 class="truncate text-[0.8rem] font-extrabold text-[#13251c]">@insumo.Nombre</h3>
                                            <p class="mt-0.5 text-[0.66rem] font-semibold text-[#5f6f66]">@insumo.StockActual.ToString("0.#") / @insumo.StockMaximo.ToString("0.#") @insumo.UnidadMedida</p>
                                        </div>
                                        <span class="rs-badge rs-badge--@color">@(porcentaje >= 60m ? "Bien" : porcentaje >= 30m ? "Alerta" : "Bajo")</span>
                                    </div>
                                    <div class="mt-3">
                                        <div class="mb-1.5 flex items-center justify-between text-[0.62rem] font-bold text-[#5f6f66]">
                                            <span>@(insumo.DiasCobertura is { } dias ? $"{dias:0.#} días de cobertura" : "Sin estimación de días")</span>
                                            <span>@porcentaje.ToString("0.#")%</span>
                                        </div>
                                        <div class="rs-progress">
                                            <span class="rs-progress__bar rs-progress__bar--@color" style="width:@porcentaje%"></span>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </div>
            </div>

            <aside class="space-y-4">
                <div class="rs-panel">
                    <div class="rs-panel__head">
                        <h2 class="rs-panel__title">Estado de la despensa</h2>
                    </div>
                    <div class="rs-panel__body">
                        <div class="flex items-end justify-between gap-3">
                            <div>
                                <p class="text-[0.62rem] font-black uppercase tracking-[0.13em] text-[#5f6f66]">Abastecimiento</p>
                                <p class="mt-1 font-display text-4xl font-extrabold tracking-[-0.06em] text-[#13251c]">@comedor.PorcentajeAbastecimiento.ToString("0.#")%</p>
                            </div>
                            <span class="@Presentacion.ClaseEstado(comedor.Estado)">@Presentacion.EtiquetaEstado(comedor.Estado)</span>
                        </div>
                        <div class="rs-progress mt-4">
                            <span class="@Presentacion.ClaseBarra(comedor.Estado)" style="width:@Math.Clamp(comedor.PorcentajeAbastecimiento, 0m, 100m)%"></span>
                        </div>
                        <p class="rs-help">El porcentaje se calcula con el stock actual frente al stock máximo de cada insumo.</p>
                    </div>
                </div>

                <div class="rs-card rs-card--soft p-5">
                    <p class="text-[0.62rem] font-black uppercase tracking-[0.14em] text-[#1b6b4a]">Cómo ayudar</p>
                    <h2 class="mt-1.5 font-display text-lg font-extrabold tracking-[-0.03em]">Este comedor necesita tu apoyo.</h2>
                    <p class="mt-2 text-[0.78rem] leading-6 text-[#5f6f66]">Puedes donar un insumo concreto desde el formulario y recibir un código para seguir tu aporte.</p>
                    <a class="rs-btn rs-btn--primary rs-btn--block mt-4" asp-controller="Home" asp-action="Donaciones">Quiero donar</a>
                    <a class="rs-link-arrow mt-3" asp-controller="Seguimiento" asp-action="Index">Ya doné, quiero seguimiento</a>
                </div>

                <div class="rs-alert rs-alert--info">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 shrink-0">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 11v5" />
                        <path d="M12 8h.01" />
                    </svg>
                    <span>La información del inventario depende de que el comedor la mantenga actualizada.</span>
                </div>
            </aside>
        </div>
    </section>
}
