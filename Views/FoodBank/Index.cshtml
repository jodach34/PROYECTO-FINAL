@model BancoAlimentosViewModel
@{
    ViewData["Title"] = "Banco de Alimentos";
    Layout = null;
}

@await Html.PartialAsync("_RescautaHead")

<body class="bg-canvas h-screen flex flex-col overflow-hidden text-ink antialiased">

    @await Html.PartialAsync("_RescautaNav", "banco")

    <div class="flex-1 overflow-y-auto p-8 grid grid-cols-2 gap-8 items-start">

        @* ================= COLUMNA IZQUIERDA: FORMULARIO ================= *@
        <div class="bg-white p-6 rounded-2xl shadow-card border border-gray-200">
            <h1 class="text-lg font-extrabold text-ink">Registrar Donación de Insumos</h1>
            <p class="text-xs text-muted mt-1 mb-6">Ayuda a reabastecer las ollas comunes más críticas ingresando tu aporte.</p>

            @if (Model.Error is not null)
            {
                @* El motivo del rechazo se muestra tal cual lo dio la API. Ocultarlo y
                   poner "algo salió mal" hace que el operador repita el mismo envio. *@
                <div class="mb-4 px-3.5 py-3 rounded-lg bg-critico/10 border border-critico/25 text-[11px] text-critico font-semibold" role="alert">
                    @Model.Error
                </div>
            }

            @if (Model.Exito is not null)
            {
                <div class="mb-4 px-3.5 py-3 rounded-lg bg-ok/10 border border-ok/25 text-[11px] text-ok font-semibold" role="status">
                    Donación registrada. Código de seguimiento:
                    <span class="font-mono font-extrabold">@Model.Exito</span>
                </div>
            }

            @* asp-* genera el action y el token anti-falsificacion solo. El token va porque
               el formulario hace un POST que cambia la base: sin el, cualquier pagina
               ajena podria mandar donaciones en nombre de este operador. *@
            <form method="post" asp-controller="FoodBank" asp-action="Registrar" class="space-y-4">
                <div>
                    <label for="InsumoId" class="block text-xs font-extrabold text-ink mb-1.5">Insumo a Donar *</label>
                    <select id="InsumoId" name="InsumoId" required
                            class="w-full text-xs px-3 py-2.5 border border-gray-200 rounded-xl bg-canvas focus:outline-none focus:ring-2 focus:ring-brand/30">
                        <option value="">— Elige el insumo y el comedor —</option>
                        @foreach (var insumo in Model.Insumos)
                        {
                            var elegido = Model.InsumoId == insumo.InsumoId;
                            <option value="@insumo.InsumoId" selected="@elegido">@insumo.Texto</option>
                        }
                    </select>
                    <p class="text-[10px] text-muted mt-1">
                        Cada opción es un insumo concreto de una despensa. El stock se suma al
                        que ya tiene ese comedor.
                    </p>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label for="Cantidad" class="block text-xs font-extrabold text-ink mb-1.5">Cantidad *</label>
                        <input id="Cantidad" name="Cantidad" type="number" min="1" required
                               value="@Model.Cantidad"
                               class="w-full text-xs px-3 py-2.5 border border-gray-200 rounded-xl bg-canvas focus:outline-none focus:ring-2 focus:ring-brand/30" />
                    </div>
                    <div>
                        <label for="PuntoRecojo" class="block text-xs font-extrabold text-ink mb-1.5">Punto de Recojo</label>
                        <input id="PuntoRecojo" name="PuntoRecojo" type="text" value="@Model.PuntoRecojo"
                               placeholder="Dirección del donante"
                               class="w-full text-xs px-3 py-2.5 border border-gray-200 rounded-xl bg-canvas focus:outline-none focus:ring-2 focus:ring-brand/30" />
                    </div>
                </div>

                <div>
                    <label for="Donante" class="block text-xs font-extrabold text-ink mb-1.5">Nombre del Donante *</label>
                    <input id="Donante" name="Donante" type="text" required value="@Model.Donante"
                           placeholder="Persona o institución que dona"
                           class="w-full text-xs px-3 py-2.5 border border-gray-200 rounded-xl bg-canvas focus:outline-none focus:ring-2 focus:ring-brand/30" />
                </div>

                <button type="submit"
                        class="w-full bg-brand hover:bg-brand-dk text-white py-3 rounded-xl text-xs font-extrabold tracking-wide transition-colors shadow-sm">
                    Confirmar Donación y Generar Código de Seguimiento
                </button>
            </form>
        </div>

        @* ================= COLUMNA DERECHA: COMEDORES + RESULTADO ================= *@
        <div class="space-y-6">

            <div class="bg-white p-6 rounded-2xl shadow-card border border-gray-200">
                <h2 class="font-extrabold text-ink text-base">Comedores y su Urgencia</h2>
                <p class="text-xs text-muted mt-1 mb-5">Ordenados por abastecimiento: primero los que mas lo necesitan.</p>

                @if (Model.Comedores.Count == 0)
                {
                    <p class="py-6 text-center text-xs text-muted">No hay comedores registrados.</p>
                }
                else
                {
                    <table class="w-full text-left text-xs mb-5">
                        <thead>
                            <tr class="border-b border-gray-200 text-[10px] text-gray-400 uppercase tracking-widest">
                                <th class="py-2 font-bold">Comedor</th>
                                <th class="py-2 font-bold">Urgencia</th>
                                <th class="py-2 font-bold">Stock</th>
                                <th class="py-2 font-bold">Raciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @foreach (var comedor in Model.Comedores.OrderBy(c => c.PorcentajeAbastecimiento))
                            {
                                var pct = (double)comedor.PorcentajeAbastecimiento;

                                <tr>
                                    <td class="py-3 font-extrabold text-ink">
                                        @comedor.Nombre
                                        <span class="block text-[10px] text-muted font-medium mt-0.5">@comedor.Distrito</span>
                                    </td>
                                    <td class="py-3">
                                        <span class="px-2 py-1 rounded font-extrabold text-[10px] @(comedor.Estado == "Emergencia" ? "bg-critico text-white" : Presentacion.ClaseEstado(comedor.Estado))">@comedor.Estado</span>
                                    </td>
                                    <td class="py-3">
                                        <span class="font-extrabold @(Presentacion.TextColorEstado(comedor.Estado))">@comedor.PorcentajeAbastecimiento.ToString("0.#")%</span>
                                        <span class="block w-16 bg-gray-200 h-1 rounded-full mt-1 overflow-hidden">
                                            <span class="block h-full bg-@Presentacion.ColorEstado(comedor.Estado)" style="width:@pct.ToString("0.##")%"></span>
                                        </span>
                                    </td>
                                    <td class="py-3 font-semibold text-muted">@comedor.RacionesDiarias/día</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            @* --- Confirmación con el código real --- *@
            @* El codigo sale de la API, no de un texto fijo. La maqueta mostraba siempre
               DON-2026-00421, que hacia creer al operador que su donacion ya estaba
               registrada con ese numero. *@
            @if (Model.Exito is not null)
            {
                var ultima = Model.Donaciones.FirstOrDefault();

                <div class="bg-brand-lt border border-brand/20 rounded-2xl p-5">
                    <p class="text-[10px] font-extrabold text-brand tracking-widest uppercase">Código de seguimiento generado</p>
                    <p class="font-mono font-extrabold text-lg text-ink mt-0.5">@Model.Exito</p>
                    @if (ultima is not null)
                    {
                        <p class="text-xs text-muted mt-1">
                            Asignado a: <span class="font-extrabold text-ink">@ultima.ComedorNombre</span>
                            • @ultima.InsumoNombre (@ultima.Cantidad @ultima.UnidadMedida)
                            • Stock resultante: <span class="font-extrabold text-ink">@ultima.StockResultante.ToString("0.##")</span>
                        </p>
                    }
                </div>
            }

            @* --- Historial de donaciones --- *@
            @if (Model.Donaciones.Count > 0)
            {
                <div class="bg-white p-6 rounded-2xl shadow-card border border-gray-200">
                    <h2 class="font-extrabold text-ink text-base">Donaciones Recientes</h2>
                    <table class="w-full text-left text-xs mt-4">
                        <thead>
                            <tr class="border-b border-gray-200 text-[10px] text-gray-400 uppercase tracking-widest">
                                <th class="py-2 font-bold">Código</th>
                                <th class="py-2 font-bold">Donante</th>
                                <th class="py-2 font-bold">Comedor</th>
                                <th class="py-2 font-bold">Cantidad</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @foreach (var donacion in Model.Donaciones)
                            {
                                <tr>
                                    <td class="py-2.5 font-mono font-bold text-[10px] text-ink">@donacion.CodigoSeguimiento</td>
                                    <td class="py-2.5 text-muted">@donacion.Donante</td>
                                    <td class="py-2.5 text-muted">@donacion.ComedorNombre</td>
                                    <td class="py-2.5 font-extrabold text-ok">+@donacion.Cantidad @donacion.UnidadMedida</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</body>
</html>
