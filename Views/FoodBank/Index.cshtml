@{
    ViewData["Title"] = "Banco de Alimentos - Rescauta";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 h-screen flex flex-col overflow-hidden">

    <!-- Barra de Navegación Superior -->
    <header class="bg-white border-b px-6 py-3 flex justify-between items-center shadow-sm z-10">
        <div class="flex items-center space-x-6">
            <div class="flex items-center space-x-2">
                <span class="bg-green-600 text-white p-1.5 rounded-lg font-bold text-sm">🥗 Rescauta</span>
                <span class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Logística Comunitaria</span>
            </div>
            <nav class="flex space-x-6 text-sm font-semibold">
                <a href="/Home/Index" class="text-gray-500 hover:text-gray-700">Mapa Interactivo</a>
                <a href="/ControlPanel/Index" class="text-gray-500 hover:text-gray-700">Panel de Control</a>
                <a href="/FoodBank/Index" class="text-green-700 border-b-2 border-green-600 pb-1">Banco de Alimentos</a>
            </nav>
        </div>

        <div class="flex items-center space-x-4">
            <div class="relative">
                <input type="text" placeholder="Buscar comedores, alertas..." class="bg-gray-100 text-sm rounded-full pl-9 pr-4 py-1.5 w-64 border focus:outline-none" />
                <span class="absolute left-3 top-2.5 text-gray-400 text-xs">🔍</span>
            </div>
            <div class="flex items-center space-x-2 border-l pl-4">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100" alt="Usuario" class="w-8 h-8 rounded-full object-cover">
                <div class="text-left">
                    <p class="text-xs font-bold text-gray-800">María Elena S.</p>
                    <p class="text-[10px] text-gray-500">Coordinadora SJM</p>
                </div>
            </div>
        </div>
    </header>

    <!-- Contenido Principal: Dos Columnas -->
    <div class="flex-1 overflow-y-auto p-8 grid grid-cols-2 gap-8">
        
        <!-- Columna Izquierda: Formulario de Registro de Donación -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200">
            <h2 class="text-lg font-bold text-gray-900 mb-1">Registrar Donación de Insumos</h2>
            <p class="text-xs text-gray-500 mb-6">Ayuda a reabastecer las ollas comunes más críticas ingresando tu aporte.</p>
            
            <form class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Categoría del Insumo *</label>
                    <select class="w-full text-xs p-2.5 border rounded-xl bg-gray-50 focus:ring-2 focus:ring-green-500">
                        <option>Alimentos Secos (Arroz, Menestras, Conservas)</option>
                        <option>Agua Potable y Líquidos</option>
                        <option>Balones de Gas (GLP)</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Nombre Específico del Producto *</label>
                    <input type="text" value="Sacos de Arroz Costeño de 50kg" class="w-full text-xs p-2.5 border rounded-xl bg-gray-50" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Cantidad *</label>
                        <input type="number" value="4" class="w-full text-xs p-2.5 border rounded-xl bg-gray-50" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Unidad de Medida *</label>
                        <select class="w-full text-xs p-2.5 border rounded-xl bg-gray-50">
                            <option>Unidades (Sacos de 50kg)</option>
                            <option>Kilogramos (kg)</option>
                            <option>Litros (L)</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Fecha de Caducidad Aprox.</label>
                    <input type="text" value="12 / 10 / 2026" class="w-full text-xs p-2.5 border rounded-xl bg-gray-50" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Dirección o Punto de Recojo del Donante *</label>
                    <input type="text" value="Av. Primavera 1280, Santiago de Surco, Lima" class="w-full text-xs p-2.5 border rounded-xl bg-gray-50" />
                </div>
            </form>
        </div>

        <!-- Columna Derecha: Recomendación y Código QR Generado -->
        <div class="space-y-6">
            <!-- Comedores Recomendados -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200">
                <h3 class="font-bold text-gray-900 text-base mb-1">Comedores Recomendados por Urgencia</h3>
                <p class="text-xs text-gray-500 mb-4">El sistema pre-selecciona las comunidades de mayor prioridad y cercanía para tu donación.</p>

                <table class="w-full text-left text-xs mb-4">
                    <thead>
                        <tr class="border-b text-[10px] text-gray-400 uppercase">
                            <th class="py-2">Comedor</th>
                            <th class="py-2">Urgencia</th>
                            <th class="py-2">Distancia</th>
                            <th class="py-2">Raciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y">
                        <tr class="bg-green-50">
                            <td class="py-2.5 font-bold text-gray-800">Olla Común La Esperanza<br><span class="text-[10px] text-gray-500 font-normal">San Juan de Miraflores</span></td>
                            <td class="py-2.5"><span class="bg-red-100 text-red-600 px-2 py-0.5 rounded font-bold text-[10px]">EMERGENCIA</span></td>
                            <td class="py-2.5 font-medium text-gray-600">4.2 km</td>
                            <td class="py-2.5 font-medium text-gray-600">180/día</td>
                        </tr>
                        <tr>
                            <td class="py-2.5 font-bold text-gray-800">Comedor Santa Rosa<br><span class="text-[10px] text-gray-500 font-normal">Villa María del Triunfo</span></td>
                            <td class="py-2.5"><span class="bg-yellow-100 text-yellow-700 px-2 py-0.5 rounded font-bold text-[10px]">ALERTA CRÍTICA</span></td>
                            <td class="py-2.5 font-medium text-gray-600">6.5 km</td>
                            <td class="py-2.5 font-medium text-gray-600">150/día</td>
                        </tr>
                        <tr>
                            <td class="py-2.5 font-bold text-gray-800">Comedor Las Palmeras<br><span class="text-[10px] text-gray-500 font-normal">Lurigancho-Chosica</span></td>
                            <td class="py-2.5"><span class="bg-green-100 text-green-700 px-2 py-0.5 rounded font-bold text-[10px]">ABASTECIDO</span></td>
                            <td class="py-2.5 font-medium text-gray-600">18.1 km</td>
                            <td class="py-2.5 font-medium text-gray-600">220/día</td>
                        </tr>
                    </tbody>
                </table>

                <button class="w-full bg-green-700 hover:bg-green-800 text-white py-3 rounded-xl text-xs font-bold transition shadow flex items-center justify-center space-x-2">
                    <span>✅ Confirmar Donación y Generar Código de Seguimiento</span>
                </button>
            </div>

            <!-- Código QR Generado -->
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-green-200 bg-green-50 flex items-center space-x-4">
                <div class="bg-white p-2 border rounded-xl shadow-inner">
                    <!-- Simulación de Código QR -->
                    <div class="w-16 h-16 bg-gray-900 flex items-center justify-center text-white text-[10px] font-mono text-center leading-tight">
                        [QR CODE]
                    </div>
                </div>
                <div>
                    <span class="text-[10px] font-extrabold text-green-700 tracking-wider">CÓDIGO DE SEGUIMIENTO GENERADO</span>
                    <h4 class="font-mono font-bold text-lg text-gray-900">DON-2026-00421</h4>
                    <p class="text-xs text-gray-600">Asignado a: <span class="font-bold">Olla Común La Esperanza</span> • Sacos de Arroz Costeño de 50kg (x4)</p>
                </div>
            </div>
        </div>
    </div>

</body>
</html>