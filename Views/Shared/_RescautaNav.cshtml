@*
    Header comun. Uso:  @await Html.PartialAsync("_RescautaNav", "mapa")
    Valores admitidos para `active`: "mapa" | "panel" | "banco"
*@
@{
    var active = (Model as string) ?? "mapa";

    var tabs = new[] {
        new { Key = "mapa",  Label = "Mapa Interactivo",   Url = "/Home/Index" },
        new { Key = "panel", Label = "Panel de Control",   Url = "/ControlPanel/Index" },
        new { Key = "banco", Label = "Banco de Alimentos", Url = "/FoodBank/Index" },
        new { Key = "estado", Label = "Estado y Sesion",    Url = "/StateDemo/Index" }
    };
}

<header class="bg-white border-b border-gray-200 px-6 py-3 flex items-center justify-between gap-6 shadow-sm z-20 flex-none">
    <div class="flex items-center gap-6 min-w-0">
        <a href="/Home/Index" class="flex items-center gap-2 flex-none">
            <span class="bg-brand text-white w-9 h-9 rounded-lg flex items-center justify-center shadow-sm">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" />
                    <path d="M7 2v20" />
                    <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3zm0 0v7" />
                </svg>
            </span>
            <span class="leading-none">
                <span class="block text-brand font-extrabold text-base tracking-tight">Rescauta</span>
                <span class="block text-[10px] text-gray-400 font-semibold uppercase tracking-widest">Logística Comunitaria</span>
            </span>
        </a>

        <nav class="flex items-center gap-6 text-sm font-semibold">
            @foreach (var tab in tabs)
            {
                var isActive = tab.Key == active;
                <a href="@tab.Url"
                   class="@(isActive
                       ? "text-brand border-b-2 border-brand pb-0.5"
                       : "text-muted hover:text-ink border-b-2 border-transparent pb-0.5 transition-colors")">
                    @tab.Label
                </a>
            }
        </nav>
    </div>

    <div class="flex items-center gap-4 flex-none">
        <div class="relative">
            <input type="text" placeholder="Buscar comedores, alertas..."
                   class="bg-canvas text-sm rounded-full pl-9 pr-4 py-1.5 w-64 border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand/30" />
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
                </svg>
            </span>
        </div>

        <div class="flex items-center gap-2 border-l border-gray-200 pl-4">
            <span class="w-8 h-8 rounded-full bg-brand-lt text-brand flex items-center justify-center text-xs font-bold ring-1 ring-brand/20">ME</span>
            <div class="leading-tight">
                <p class="text-xs font-bold text-ink">María Elena S.</p>
                <p class="text-[10px] text-muted">Coordinadora SJM</p>
            </div>
        </div>
    </div>
</header>
