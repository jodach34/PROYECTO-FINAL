@{
    var path = Context.Request.Path.Value ?? "/";
    var isHome = path == "/" || path.Equals("/Home/Index", StringComparison.OrdinalIgnoreCase);
    var isAbout = path.StartsWith("/Nosotros", StringComparison.OrdinalIgnoreCase);
    var isHow = path.StartsWith("/ComoFunciona", StringComparison.OrdinalIgnoreCase);
    var isKitchens = path.StartsWith("/Comedores", StringComparison.OrdinalIgnoreCase);
    var isDonate = path.StartsWith("/Donar", StringComparison.OrdinalIgnoreCase);
    var isContact = path.StartsWith("/Contacto", StringComparison.OrdinalIgnoreCase);
}
<header class="rs-public-nav">
    <div class="rs-container">
        <nav class="rs-public-nav__bar" aria-label="Navegación principal">
            <a class="rs-brand" asp-controller="Home" asp-action="Index" aria-label="Rescauta, ir al inicio">
                <span class="rs-brand__mark" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 12h16" />
                        <path d="M5 12a7 7 0 0 0 14 0" />
                        <path d="M8 8c1.2-2.2 2.6-3.3 4-3.3S14.8 5.8 16 8" />
                        <path d="M9 16h6" />
                    </svg>
                </span>
                <span>
                    <span class="rs-brand__name">Rescauta</span>
                    <span class="rs-brand__tag">Comida que vuelve a servir</span>
                </span>
            </a>

            <div class="rs-public-nav__links">
                <a class="rs-nav-link @(isHome ? "is-active" : null)" asp-controller="Home" asp-action="Index">Inicio</a>
                <a class="rs-nav-link @(isAbout ? "is-active" : null)" asp-controller="Home" asp-action="Nosotros">Nosotros</a>
                <a class="rs-nav-link @(isHow ? "is-active" : null)" asp-controller="Home" asp-action="ComoFunciona">Cómo funciona</a>
                <a class="rs-nav-link @(isKitchens ? "is-active" : null)" asp-controller="Comedores" asp-action="Index">Comedores</a>
                <a class="rs-nav-link @(isDonate ? "is-active" : null)" asp-controller="Home" asp-action="Donaciones">Donaciones</a>
                <a class="rs-nav-link @(isContact ? "is-active" : null)" asp-controller="Home" asp-action="Contacto">Contacto</a>
            </div>

            <div class="rs-public-nav__actions">
                <a class="rs-btn rs-btn--ghost rs-btn--sm" asp-controller="Seguimiento" asp-action="Index">Seguimiento</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Administrador"))
                    {
                        <a class="rs-btn rs-btn--ghost rs-btn--sm" asp-controller="AdminUsuarios" asp-action="Index">Administración</a>
                    }
                    @if (User.IsInRole("Administrador") || User.IsInRole("Coordinador") || User.IsInRole("Operador"))
                    {
                        <a class="rs-btn rs-btn--ghost rs-btn--sm" asp-controller="ControlPanel" asp-action="Index">Panel</a>
                    }
                    <a class="rs-btn rs-btn--secondary rs-btn--sm" asp-controller="Cuenta" asp-action="MiCuenta">@User.Identity.Name</a>
                    <form method="post" asp-controller="Cuenta" asp-action="Logout">
                        <button class="rs-btn rs-btn--ghost rs-btn--sm" type="submit">Salir</button>
                    </form>
                }
                else
                {
                    <a class="rs-btn rs-btn--secondary rs-btn--sm" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
                }
                <a class="rs-btn rs-btn--primary rs-btn--sm" asp-controller="Home" asp-action="Donaciones">
                    Donar ahora
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14" />
                        <path d="m12 5 7 7-7 7" />
                    </svg>
                </a>
            </div>

            <button class="rs-nav-toggle" type="button" data-nav-toggle aria-controls="menu-publico" aria-expanded="false" aria-label="Abrir menú de navegación">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M4 7h16M4 12h16M4 17h16" />
                </svg>
            </button>
        </nav>

        <div class="rs-mobile-nav" id="menu-publico" data-mobile-nav>
            <a class="rs-mobile-nav__link @(isHome ? "is-active" : null)" asp-controller="Home" asp-action="Index">Inicio</a>
            <a class="rs-mobile-nav__link @(isAbout ? "is-active" : null)" asp-controller="Home" asp-action="Nosotros">Nosotros</a>
            <a class="rs-mobile-nav__link @(isHow ? "is-active" : null)" asp-controller="Home" asp-action="ComoFunciona">Cómo funciona</a>
            <a class="rs-mobile-nav__link @(isKitchens ? "is-active" : null)" asp-controller="Comedores" asp-action="Index">Comedores</a>
            <a class="rs-mobile-nav__link @(isDonate ? "is-active" : null)" asp-controller="Home" asp-action="Donaciones">Donaciones</a>
            <a class="rs-mobile-nav__link @(isContact ? "is-active" : null)" asp-controller="Home" asp-action="Contacto">Contacto</a>
            <a class="rs-mobile-nav__link" asp-controller="Seguimiento" asp-action="Index">Seguimiento de donación</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="rs-mobile-nav__link" asp-controller="Cuenta" asp-action="MiCuenta">Mi cuenta</a>
                @if (User.IsInRole("Administrador"))
                {
                    <a class="rs-mobile-nav__link" asp-controller="AdminUsuarios" asp-action="Index">Administración</a>
                }
                @if (User.IsInRole("Administrador") || User.IsInRole("Coordinador") || User.IsInRole("Operador"))
                {
                    <a class="rs-mobile-nav__link" asp-controller="ControlPanel" asp-action="Index">Panel operativo</a>
                }
            }
            <div class="grid grid-cols-2 gap-2 pt-4">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" asp-controller="Cuenta" asp-action="Logout">
                        <button class="rs-btn rs-btn--secondary w-full" type="submit">Cerrar sesión</button>
                    </form>
                }
                else
                {
                    <a class="rs-btn rs-btn--secondary" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
                }
                <a class="rs-btn rs-btn--primary" asp-controller="Home" asp-action="Donaciones">Donar ahora</a>
            </div>
        </div>
    </div>
</header>
