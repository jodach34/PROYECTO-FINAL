@model MapaViewModel
@{
    var mapCompact = ViewData["MapCompact"] as bool? == true;
}
<div class="rs-map rs-map--leaflet @(mapCompact ? "rs-map--compact" : null)" data-leaflet-map>
    <div class="rs-map__viewport">
        <div class="rs-map__canvas" data-map-canvas></div>

        <p class="rs-map__empty" data-map-empty @(Model.PuntosMapa.Count > 0 ? "hidden" : null)>
            No hay comedores con coordenadas válidas para mostrar.
        </p>

        <div class="rs-map__legend" aria-label="Leyenda del mapa">
            <p class="rs-map__legend-title">Estado de abastecimiento</p>
            <p class="rs-map__legend-row"><span class="rs-map__dot" style="background:#2b8a5b"></span> Abastecido</p>
            <p class="rs-map__legend-row"><span class="rs-map__dot" style="background:#b46b10"></span> Alerta</p>
            <p class="rs-map__legend-row"><span class="rs-map__dot" style="background:#b33a48"></span> Emergencia</p>
            <p class="rs-map__legend-row"><span class="rs-map__dot" style="background:#8b9a91"></span> Sin datos</p>
        </div>
    </div>

    <div hidden data-map-points>
        @foreach (var punto in Model.PuntosMapa)
        {
            <span data-map-point
                  data-id="@punto.Id"
                  data-nombre="@punto.Nombre"
                  data-direccion="@punto.Direccion"
                  data-distrito="@punto.Distrito"
                  data-estado="@punto.Estado"
                  data-estado-label="@Presentacion.EtiquetaEstado(punto.Estado)"
                  data-tono="@Presentacion.ColorEstado(punto.Estado)"
                  data-lat="@punto.Latitud.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)"
                  data-lng="@punto.Longitud.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)"
                  data-url="@Url.Action("Detalle", "Comedores", new { id = punto.Id })"></span>
        }
    </div>

    <p class="rs-map__note">
        <strong>Mapa interactivo:</strong> los pines usan la posición de zona registrada para
        cada comedor y no representan una ubicación GPS exacta. Selecciona un marcador para ver
        su nombre, dirección y distrito.
    </p>
</div>

<script>
    (function () {
        "use strict";

        const root = document.currentScript.closest("[data-leaflet-map]");

        if (!root || typeof L === "undefined") {
            return;
        }

        const canvas = root.querySelector("[data-map-canvas]");
        const pointNodes = Array.from(root.querySelectorAll("[data-map-point]"));

        if (!canvas) {
            return;
        }

        const map = L.map(canvas, {
            scrollWheelZoom: false,
            zoomControl: false
        });

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>'
        }).addTo(map);

        L.control.zoom({ position: "topright" }).addTo(map);

        const layer = L.featureGroup().addTo(map);
        const markers = new Map();
        const pinSvg = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16"/><path d="M5 12a7 7 0 0 0 14 0"/><path d="M9 16h6"/></svg>';

        const crearPopup = function (node) {
            const popup = document.createElement("div");
            popup.className = "rs-map-popup";

            const estado = document.createElement("span");
            estado.className = "rs-badge rs-badge--" + (node.dataset.tono || "muted");
            estado.textContent = node.dataset.estadoLabel || "Sin datos";

            const titulo = document.createElement("strong");
            titulo.className = "rs-map-popup__title";
            titulo.textContent = node.dataset.nombre || "Comedor";

            const distrito = document.createElement("p");
            distrito.className = "rs-map-popup__meta";
            distrito.textContent = node.dataset.distrito || "Distrito no registrado";

            const direccion = document.createElement("p");
            direccion.className = "rs-map-popup__address";
            direccion.textContent = node.dataset.direccion || "Dirección no registrada";

            const enlace = document.createElement("a");
            enlace.className = "rs-map-popup__link";
            enlace.href = node.dataset.url || "#";
            enlace.textContent = "Ver ficha →";

            popup.append(estado, titulo, distrito, direccion, enlace);

            return popup;
        };

        pointNodes.forEach(function (node) {
            const latitud = Number(node.dataset.lat);
            const longitud = Number(node.dataset.lng);

            if (!Number.isFinite(latitud) || !Number.isFinite(longitud)) {
                return;
            }

            const tono = node.dataset.tono || "muted";
            const icono = L.divIcon({
                className: "rs-leaflet-pin",
                html: '<span class="rs-leaflet-pin__dot rs-leaflet-pin__dot--' + tono + '">' + pinSvg + '</span>' +
                      '<span class="rs-leaflet-pin__stem rs-leaflet-pin__stem--' + tono + '"></span>',
                iconSize: [36, 46],
                iconAnchor: [18, 46],
                popupAnchor: [0, -42]
            });

            const marker = L.marker([latitud, longitud], {
                icon: icono,
                title: node.dataset.nombre || "Comedor",
                alt: node.dataset.nombre || "Comedor"
            });

            marker.bindPopup(crearPopup(node), {
                minWidth: 220,
                maxWidth: 300,
                closeButton: true
            });

            layer.addLayer(marker);
            markers.set(node.dataset.id, marker);
        });

        const ajustarVista = function () {
            if (!layer.getLayers().length) {
                map.setView([-12.18, -76.95], 10);
                return;
            }

            map.fitBounds(layer.getBounds().pad(0.18), { maxZoom: 13 });
        };

        ajustarVista();

        root.addEventListener("rescauta:filtro", function (event) {
            const visibles = new Set(event.detail && event.detail.ids ? event.detail.ids : []);

            markers.forEach(function (marker, id) {
                if (visibles.has(id)) {
                    if (!layer.hasLayer(marker)) {
                        layer.addLayer(marker);
                    }
                } else if (layer.hasLayer(marker)) {
                    layer.removeLayer(marker);
                }
            });

            const vacio = root.querySelector("[data-map-empty]");
            if (vacio) {
                vacio.hidden = layer.getLayers().length !== 0;
            }

            ajustarVista();
        });

        root.addEventListener("rescauta:resize", function () {
            window.setTimeout(function () {
                map.invalidateSize();
                ajustarVista();
            }, 60);
        });

        if ("ResizeObserver" in window) {
            new ResizeObserver(function () {
                map.invalidateSize();
            }).observe(canvas);
        }
    })();
</script>
