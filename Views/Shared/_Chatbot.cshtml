@{
    var preguntas = new[]
    {
        "¿Cómo registro una donación?",
        "¿Cómo confirmo la recepción de alimentos?",
        "¿Cómo registro alimentos en el inventario?",
        "¿Cómo consulto el Kardex?",
        "¿Cómo hago seguimiento a una donación?"
    };
}

<div class="rs-chatbot" data-chatbot>
    <section class="rs-chatbot__panel"
             id="chatbot-rescauta"
             role="dialog"
             aria-labelledby="chatbot-rescauta-title"
             data-chatbot-panel
             hidden>
        <header class="rs-chatbot__header">
            <div class="rs-chatbot__identity">
                <span class="rs-chatbot__avatar" aria-hidden="true">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3 13.4 7.6 18 9l-4.6 1.4L12 15l-1.4-4.6L6 9l4.6-1.4L12 3Z" />
                        <path d="M5 15.5 5.8 18l2.5.8-2.5.8L5 22l-.8-2.4-2.5-.8 2.5-.8L5 15.5Z" />
                    </svg>
                </span>
                <div>
                    <p class="rs-chatbot__title" id="chatbot-rescauta-title">Asistente de Rescauta</p>
                    <p class="rs-chatbot__subtitle">Ayuda rápida · respuestas guiadas</p>
                </div>
            </div>

            <button class="rs-chatbot__close" type="button" data-chatbot-close aria-label="Cerrar asistente">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                    <path d="m6 6 12 12M18 6 6 18" />
                </svg>
            </button>
        </header>

        <div class="rs-chatbot__messages" data-chatbot-messages role="log" aria-live="polite" aria-relevant="additions">
            <div class="rs-chatbot__message rs-chatbot__message--bot">
                <span class="rs-chatbot__bubble">¡Hola! Soy el asistente de Rescauta. ¿En qué puedo ayudarte?</span>
            </div>
        </div>

        <div class="rs-chatbot__suggestions" aria-label="Preguntas frecuentes">
            <p class="rs-chatbot__suggestions-label">Preguntas frecuentes</p>
            <div class="rs-chatbot__suggestions-list">
                @foreach (var pregunta in preguntas)
                {
                    <button class="rs-chatbot__suggestion" type="button" data-chatbot-question="@pregunta">@pregunta</button>
                }
            </div>
        </div>

        <form class="rs-chatbot__form" data-chatbot-form>
            <input class="rs-chatbot__input"
                   type="text"
                   maxlength="240"
                   autocomplete="off"
                   placeholder="Escribe tu pregunta..."
                   aria-label="Escribe tu pregunta"
                   data-chatbot-input />
            <button class="rs-chatbot__send" type="submit" aria-label="Enviar pregunta">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m4 4 17 8-17 8 3-8-3-8Z" />
                    <path d="M7 12h14" />
                </svg>
            </button>
        </form>
    </section>

    <button class="rs-chatbot__trigger"
            type="button"
            data-chatbot-toggle
            aria-controls="chatbot-rescauta"
            aria-expanded="false"
            aria-label="Abrir asistente de Rescauta">
        <span class="rs-chatbot__trigger-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a8 8 0 0 1-8 8H7l-4 3v-5.5A8 8 0 0 1 11 4h2a8 8 0 0 1 8 8Z" />
                <path d="M8.5 11h.01M12 11h.01M15.5 11h.01" />
            </svg>
        </span>
        <span class="rs-chatbot__trigger-label">Ayuda</span>
    </button>
</div>
