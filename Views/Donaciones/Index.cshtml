@model DonacionesGestionViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Gestión de donaciones";
    ViewData["AppSection"] = "Banco de alimentos";
    ViewData["AppTitle"] = "Gestión de donaciones";

    var estados = new[]
    {
        (Valor: "Pendiente", Texto: "Pendiente"),
        (Valor: "Confirmada", Texto: "Confirmada"),
        (Valor: "EnTransito", Texto: "En tránsito"),
        (Valor: "Entregada", Texto: "Entregada"),
        (Valor: "Cancelada", Texto: "Cancelada"),
        (Valor: "Anulada", Texto: "Anulada")
    };
}

<div class="rs-page-head">
    <div>
        <p class="rs-eyebrow">Trazabilidad</p>
        <h1 class="rs-page-title">Cada donación, con su estado real.</h1>
        <p class="rs-page-subtitle">Filtra por comedor y estado, confirma la recepción y mueve la donación hasta la entrega. El stock entra al confirmar, no al registrar.</p>
    </div>
    <div class="flex flex-wrap gap-2">
        <a class="rs-btn rs-btn--secondary" asp-controller="FoodBank" asp-action="Index">Registrar donación</a>
        <a class="rs-btn rs-btn--secondary" asp-controller="ControlPanel" asp-action="Index">Volver al panel</a>
    </div>
</div>

@if (Model.Exito is not null)
{
    <div class="rs-alert rs-alert--ok mb-4" role="status">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 shrink-0">
            <path d="m5 12 4 4L19 6" />
        </svg>
        <span>@Model.Exito</span>
    </div>
}

@if (Model.Error is not null)
{
    <div class="rs-alert rs-alert--error mb-4" role="alert">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 shrink-0">
            <path d="M12 9v4" />
            <path d="M12 17h.01" />
            <path d="M10.3 4.7 2.9 18a1.7 1.7 0 0 0 1.5 2.5h15.2a1.7 1.7 0 0 0 1.5-2.5L13.7 4.7a1.9 1.9 0 0 0-3.4 0Z" />
        </svg>
        <span>@Model.Error</span>
    </div>
}

<section class="rs-panel mb-4">
    <div class="rs-panel__body">
        <form method="get" asp-action="Index" class="grid gap-3 md:grid-cols-[1fr_1fr_1.4fr_auto] md:items-end">
            <div>
                <label class="rs-label" for="estado">Estado</label>
                <select class="rs-select" id="estado" name="estado">
                    <option value="">Todos</option>
                    @foreach (var item in estados)
                    {
                        <option value="@item.Valor" selected="@(string.Equals(Model.Estado, item.Valor, StringComparison.OrdinalIgnoreCase))">@item.Texto</option>
                    }
                </select>
            </div>
            <div>
                <label class="rs-label" for="comedorId">Comedor</label>
                <select class="rs-select" id="comedorId" name="comedorId">
                    <option value="">Todos los que puedo ver</option>
                    @foreach (var comedor in Model.Comedores.OrderBy(c => c.Nombre))
                    {
                        <option value="@comedor.Id" selected="@(Model.ComedorId == comedor.Id)">@comedor.Nombre</option>
                    }
                </select>
            </div>
            <div>
                <label class="rs-label" for="busqueda">Código o donante</label>
                <input class="rs-input" id="busqueda" name="busqueda" type="search" value="@Model.Busqueda" placeholder="DON-2026-00042 o nombre" />
            </div>
            <div class="flex gap-2">
                <input type="hidden" name="tamanoPagina" value="@Model.TamanoPagina" />
                <button class="rs-btn rs-btn--primary" type="submit">Filtrar</button>
                <a class="rs-btn rs-btn--ghost" asp-action="Index">Limpiar</a>
            </div>
        </form>
    </div>
</section>

<section class="rs-panel">
    <div class="rs-panel__head">
        <div>
            <h2 class="rs-panel__title">Donaciones</h2>
            <p class="mt-1 text-[0.7rem] text-[#5f6f66]">@Model.TotalCount registro(s) encontrados.</p>
        </div>
        <span class="rs-badge rs-badge--neutral">Página @Model.Pagina de @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</span>
    </div>

    @if (Model.Donaciones.Count == 0)
    {
        <div class="rs-panel__body">
            <p class="py-8 text-center text-[0.8rem] text-[#5f6f66]">No hay donaciones que coincidan con los filtros.</p>
        </div>
    }
    else
    {
        <div class="rs-table-wrap m-4">
            <table class="rs-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Donante</th>
                        <th>Comedor / insumo</th>
                        <th>Cantidad</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                        <th class="text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var donacion in Model.Donaciones)
                    {
                        <tr>
                            <td class="whitespace-nowrap">
                                <a class="rs-mono text-[0.68rem] font-bold text-[#1b6b4a] hover:underline" asp-action="Detalle" asp-route-id="@donacion.DonacionId">@donacion.CodigoSeguimiento</a>
                            </td>
                            <td>@donacion.Donante</td>
                            <td>
                                <span class="block font-bold">@donacion.ComedorNombre</span>
                                <span class="block text-[0.66rem] text-[#5f6f66]">@donacion.InsumoNombre</span>
                            </td>
                            <td class="whitespace-nowrap font-extrabold text-[#2b8a5b]">@donacion.Cantidad @donacion.UnidadMedida</td>
                            <td><span class="@Presentacion.ClaseEstadoDonacion(donacion.Estado)">@Presentacion.EtiquetaEstadoDonacion(donacion.Estado)</span></td>
                            <td class="whitespace-nowrap text-[0.68rem]">@donacion.FechaDonacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="flex flex-wrap justify-end gap-1.5">
                                    <a class="rs-btn rs-btn--ghost rs-btn--sm" asp-action="Detalle" asp-route-id="@donacion.DonacionId">Ver</a>
                                    @if (Presentacion.PuedeConfirmarDonacion(donacion.Estado))
                                    {
                                        <form method="post" asp-action="Confirmar">
                                            <input type="hidden" name="id" value="@donacion.DonacionId" />
                                            <button class="rs-btn rs-btn--primary rs-btn--sm" type="submit">Confirmar</button>
                                        </form>
                                    }
                                    else if (Presentacion.PuedePonerEnTransito(donacion.Estado))
                                    {
                                        <form method="post" asp-action="EnTransito">
                                            <input type="hidden" name="id" value="@donacion.DonacionId" />
                                            <button class="rs-btn rs-btn--secondary rs-btn--sm" type="submit">En tránsito</button>
                                        </form>
                                    }
                                    else if (Presentacion.PuedeEntregarDonacion(donacion.Estado))
                                    {
                                        <form method="post" asp-action="Entregar">
                                            <input type="hidden" name="id" value="@donacion.DonacionId" />
                                            <button class="rs-btn rs-btn--primary rs-btn--sm" type="submit">Entregar</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-2 border-t border-[#dce7df] px-4 py-3">
            <p class="text-[0.68rem] text-[#5f6f66]">Mostrando @Model.Donaciones.Count de @Model.TotalCount.</p>
            <div class="flex gap-2">
                @if (Model.HasPrevious)
                {
                    <a class="rs-btn rs-btn--secondary rs-btn--sm" asp-action="Index" asp-route-estado="@Model.Estado" asp-route-comedorId="@Model.ComedorId" asp-route-busqueda="@Model.Busqueda" asp-route-pagina="@(Model.Pagina - 1)" asp-route-tamanoPagina="@Model.TamanoPagina">Anterior</a>
                }
                @if (Model.HasNext)
                {
                    <a class="rs-btn rs-btn--secondary rs-btn--sm" asp-action="Index" asp-route-estado="@Model.Estado" asp-route-comedorId="@Model.ComedorId" asp-route-busqueda="@Model.Busqueda" asp-route-pagina="@(Model.Pagina + 1)" asp-route-tamanoPagina="@Model.TamanoPagina">Siguiente</a>
                }
            </div>
        </div>
    }
</section>
